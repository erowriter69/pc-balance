---
import { SITE, absoluteUrl } from "../site-config";

const title = 'CPU Bottleneck vs GPU Bottleneck: How to Tell the Difference | CalcBottleneck';
const description = 'Learn the difference between a CPU bottleneck and GPU bottleneck, the symptoms of each, how resolution and target FPS change the limiting component, and what to check before upgrading.';
const canonicalUrl = absoluteUrl('/cpu-vs-gpu-bottleneck/');
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "TechArticle",
      "@id": `${canonicalUrl}#article`,
      url: canonicalUrl,
      headline: title,
      name: title,
      description,
      inLanguage: SITE.language,
      mainEntityOfPage: canonicalUrl,
      author: { "@type": "Organization", name: SITE.name, url: absoluteUrl("/") },
      publisher: { "@type": "Organization", name: SITE.name, url: absoluteUrl("/") },
      datePublished: "2026-08-15",
      dateModified: SITE.lastReviewed,
      isPartOf: {
        "@type": "WebSite",
        "@id": `${absoluteUrl("/")}#website`,
        name: SITE.name,
        url: absoluteUrl("/"),
      },
      breadcrumb: { "@id": `${canonicalUrl}#breadcrumb` },
    },
    {
      "@type": "BreadcrumbList",
      "@id": `${canonicalUrl}#breadcrumb`,
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "CalcBottleneck", item: absoluteUrl("/") },
        { "@type": "ListItem", position: 2, name: 'CPU vs GPU Bottleneck', item: canonicalUrl },
      ],
    },
  ],
};
