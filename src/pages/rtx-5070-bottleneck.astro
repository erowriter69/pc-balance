  .pairing span { color:#9eadc2; }
  .pairing a { white-space:nowrap; text-decoration:none; }
  .faq h3 { margin-top:0; }
  .faq + .faq { margin-top:18px; padding-top:18px; border-top:1px solid rgba(255,255,255,.07); }
