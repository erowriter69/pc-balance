---
import "../styles/content-page-effects.css";
import { SITE, absoluteUrl } from "../site-config";

const title = 'RTX 5060 Ti Bottleneck Calculator (8GB & 16GB) | CalcBottleneck';
const description = 'Check RTX 5060 Ti 8GB or 16GB CPU balance at 1080p, 1440p and 4K. Compare common CPU pairings, VRAM limits and target-FPS behavior.';
const canonicalUrl = absoluteUrl('/rtx-5060-ti-bottleneck/');
const articleDate = "2026-08-22";
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "TechArticle",
      "@id": `${canonicalUrl}#article`,
      url: canonicalUrl,
      headline: title,
      name: title,
      description,
      inLanguage: SITE.language,
      mainEntityOfPage: canonicalUrl,
      author: { "@type": "Organization", name: SITE.name, url: absoluteUrl("/") },
      publisher: { "@type": "Organization", name: SITE.name, url: absoluteUrl("/") },
      datePublished: articleDate,
      dateModified: articleDate,
      about: [
        { "@type": "Thing", name: "RTX 5060 Ti" },
        { "@type": "Thing", name: "RTX 5060 Ti 16GB" },
        { "@type": "Thing", name: "RTX 5060 Ti 8GB" },
        { "@type": "Thing", name: "CPU bottleneck" },
        { "@type": "Thing", name: "GPU bottleneck" }
      ],
      isPartOf: {
        "@type": "WebSite",
        "@id": `${absoluteUrl("/")}#website`,
        name: SITE.name,
        url: absoluteUrl("/"),
      },
      breadcrumb: { "@id": `${canonicalUrl}#breadcrumb` },
    },
    {
      "@type": "BreadcrumbList",
      "@id": `${canonicalUrl}#breadcrumb`,
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "CalcBottleneck", item: absoluteUrl("/") },
        { "@type": "ListItem", position: 2, name: "RTX 5060 Ti Bottleneck Guide", item: canonicalUrl },
      ],
    },
  ],
};
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="theme-color" content={SITE.themeColor} />
    <meta name="color-scheme" content="dark" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
