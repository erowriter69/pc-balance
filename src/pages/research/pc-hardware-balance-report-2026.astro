  .meta-chip { padding:8px 11px; border:1px solid rgba(120,170,255,.18); border-radius:999px; background:rgba(37,99,235,.08); color:#91a8c5; font-size:.78rem; }
  .snapshot-grid { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:14px; margin-top:42px; }
  .snapshot-card { padding:22px; border:1px solid rgba(255,255,255,.08); border-radius:18px; background:rgba(9,23,42,.86); }
  .snapshot-card.featured { border-color:rgba(120,170,255,.3); background:linear-gradient(135deg,rgba(37,99,235,.14),rgba(9,23,42,.94)); }
