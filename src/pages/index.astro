---
import cpus from "../data/cpus.json";
import gpus from "../data/gpus.json";
import { SITE, absoluteUrl } from "../site-config";

const title = "CPU & GPU Bottleneck Calculator – PC Balance";
const description =
  `Free CPU & GPU bottleneck calculator with ${cpus.length} CPUs and ${gpus.length} GPUs. Compare 1080p, 1440p and 4K balance, workload impact, confidence and upgrade paths.`;
const canonicalUrl = absoluteUrl("/");

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": `${canonicalUrl}#organization`,
      name: SITE.name,
      url: canonicalUrl,
      description: SITE.description,
    },
    {
      "@type": "WebSite",
      "@id": `${canonicalUrl}#website`,
      url: canonicalUrl,
      name: SITE.name,
      description: SITE.description,
      inLanguage: SITE.language,
      publisher: { "@id": `${canonicalUrl}#organization` },
    },
    {
      "@type": "WebPage",
      "@id": `${canonicalUrl}#webpage`,
      url: canonicalUrl,
      name: title,
      description,
      inLanguage: SITE.language,
      isPartOf: { "@id": `${canonicalUrl}#website` },
      about: [
        { "@type": "Thing", name: "CPU bottleneck" },
        { "@type": "Thing", name: "GPU bottleneck" },
        { "@type": "Thing", name: "PC hardware compatibility" },
      ],
      dateModified: SITE.lastReviewed,
    },
  ],
};

const getNumber = (value = "") => {
  const match = value.match(/\d+/);
  return match ? Number(match[0]) : 0;
};

const cpuTier = (name = "") => {
  const ryzen = name.match(/Ryzen\s+(\d+)/i);
  if (ryzen) return Number(ryzen[1]);

  const intel = name.match(/Core\s+i(\d)/i);
  if (intel) return Number(intel[1]);

  const ultra = name.match(/Core\s+Ultra\s+(\d)/i);
  if (ultra) return Number(ultra[1]);

  return 0;
};

const cpuModelNumber = (name = "") => {
  const matches = name.match(/\d{4,5}/g);
  return matches ? Number(matches[matches.length - 1]) : getNumber(name);
};

const gpuModelNumber = (name = "") => {
  const match = name.match(/(\d{3,4})/);
  return match ? Number(match[1]) : 0;
};

const gpuSuffixRank = (name = "") => {
  const n = name.toLowerCase();
  if (n.includes("ti super")) return 5;
  if (n.includes("super")) return 4;
  if (n.includes(" ti")) return 3;
  if (n.includes("xtx")) return 5;
  if (n.includes(" xt")) return 3;
  return 1;
};

const sortedCpus = [...cpus].sort((a, b) => {
  if (a.brand !== b.brand) {
    const brandOrder = { AMD: 0, Intel: 1 };
    return (brandOrder[a.brand] ?? 99) - (brandOrder[b.brand] ?? 99);
  }

  const tierDiff = cpuTier(a.name) - cpuTier(b.name);
  if (tierDiff !== 0) return tierDiff;

  const modelDiff = cpuModelNumber(a.name) - cpuModelNumber(b.name);
  if (modelDiff !== 0) return modelDiff;

  return a.name.localeCompare(b.name);
});

const sortedGpus = [...gpus].sort((a, b) => {
  if (a.brand !== b.brand) {
    const brandOrder = { NVIDIA: 0, AMD: 1, Intel: 2 };
    return (brandOrder[a.brand] ?? 99) - (brandOrder[b.brand] ?? 99);
  }

  const modelDiff = gpuModelNumber(a.name) - gpuModelNumber(b.name);
  if (modelDiff !== 0) return modelDiff;

  return gpuSuffixRank(a.name) - gpuSuffixRank(b.name);
});

const popularCpuIds = new Set([
  "ryzen-5-5600",
  "ryzen-7-7800x3d",
  "ryzen-7-9800x3d",
  "ryzen-9-9950x3d",
  "core-ultra-7-270k-plus",
  "i7-14700k",
]);

const popularGpuIds = new Set([
  "rtx-3060",
  "rtx-4060",
  "rtx-5070",
  "rtx-5080",
  "rx-9070-xt",
  "arc-b580",
]);

const popularCpus = sortedCpus.filter((cpu) => popularCpuIds.has(cpu.id));
const popularGpus = sortedGpus.filter((gpu) => popularGpuIds.has(gpu.id));
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <meta
      name="robots"
      content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
    />
    <meta
      name="googlebot"
      content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
    />

    <meta name="application-name" content={SITE.name} />
    <meta name="theme-color" content={SITE.themeColor} />
    <meta name="color-scheme" content="dark" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content={SITE.locale} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={absoluteUrl("/og-image.png")} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:alt" content="PC Balance CPU and GPU Bottleneck Calculator" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteUrl("/og-image.png")} />
    <meta name="twitter:image:alt" content="PC Balance CPU and GPU Bottleneck Calculator" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />

    <script type="application/ld+json" set:html={JSON.stringify(structuredData)}></script>
  </head>

  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <noscript>
      <div class="noscript-banner">
        The calculator requires JavaScript for interactive results. The explanatory content and methodology remain available without it.
      </div>
    </noscript>
    <div class="page-shell">
      <header class="site-header">
        <div class="header-inner">
          <a class="brand" href="/">
            <span class="brand-icon">⚡</span>
            <span>PC Balance</span>
          </a>

          <nav class="nav" aria-label="Primary navigation">
            <a href="#calculator">Calculator</a>
            <a href="#how-it-works">How It Works</a>
            <a href="#faq">FAQ</a>
          </nav>
        </div>
      </header>

      <main id="main-content">
        <section class="hero">
          <div class="hero-glow hero-glow-one"></div>
          <div class="hero-glow hero-glow-two"></div>

          <div class="hero-inner">
            <div class="hero-copy">
              <span class="eyebrow">PC PERFORMANCE TOOL</span>

              <h1>
                CPU & GPU
                <span>Bottleneck Calculator</span>
              </h1>

              <p class="hero-text">
                Find out whether your processor and graphics card are a balanced
                match for your resolution and workload.
              </p>

              <div class="hero-points">
                <div class="hero-point">
                  <span class="point-icon">✓</span>
                  <span>Fast hardware comparison</span>
                </div>

                <div class="hero-point">
                  <span class="point-icon">✓</span>
                  <span>Resolution-aware analysis</span>
                </div>

                <div class="hero-point">
                  <span class="point-icon">✓</span>
                  <span>Clear upgrade guidance</span>
                </div>
              </div>
            </div>

            <div class="hardware-visual" aria-hidden="true">
              <div class="visual-card cpu-card">
                <span class="visual-label">CPU</span>
                <div class="chip">
                  <div class="chip-core"></div>
                  <span>PROCESSOR</span>
                </div>
              </div>

              <div class="connection">
                <span class="connection-line"></span>

                <div class="gauge">
                  <div class="gauge-number">92%</div>
                  <span>Balanced</span>
                </div>

                <span class="connection-line"></span>
              </div>

              <div class="visual-card gpu-card">
                <span class="visual-label">GPU</span>

                <div class="gpu">
                  <div class="gpu-fans">
                    <span></span>
                    <span></span>
                  </div>
                  <div class="gpu-detail"></div>
                </div>
              </div>
            </div>
          </div>
        </section>

        <section class="calculator-section" id="calculator">
          <div class="section-heading">
            <span class="section-kicker">CHECK YOUR BUILD</span>
            <h2>Calculate Your PC Bottleneck</h2>
            <p>
              Filter by brand, choose your main components, and tell us how you plan to use your computer.
            </p>
          </div>

          <div class="calculator-card">
            <div class="pro-controls">
              <div class="hardware-picker-block">
                <div class="picker-topline">
                  <div>
                    <span class="picker-kicker">PROCESSOR</span>
                    <h3>Choose your CPU</h3>
                  </div>

                  <div class="brand-segments" data-brand-group="cpu">
                    <button type="button" class="brand-chip active" data-brand="">All</button>
                    <button type="button" class="brand-chip" data-brand="AMD">AMD</button>
                    <button type="button" class="brand-chip" data-brand="Intel">Intel</button>
                  </div>
                </div>

                <select id="cpuBrand" class="native-control" aria-hidden="true" tabindex="-1">
                  <option value="">All CPU brands</option>
                  <option value="AMD">AMD</option>
                  <option value="Intel">Intel</option>
                </select>

                <select id="cpu" class="native-control" aria-hidden="true" tabindex="-1">
                  <option value="">Select your CPU</option>
                  {
                    sortedCpus.map((cpu) => (
                      <option
                        value={cpu.id}
                        data-brand={cpu.brand}
                        data-score={cpu.score}
                        data-gaming={cpu.gamingScore}
                        data-gaming-index={cpu.gamingBenchmarkIndex}
                        data-pairing-index={cpu.pairingIndex}
                        data-pairing-status={cpu.pairingIndexStatus}
                        data-data-quality={cpu.dataQuality}
                        data-benchmark-status={cpu.gamingBenchmarkStatus}
                        data-productivity={cpu.productivityScore}
                        data-single={cpu.singleCoreScore}
                        data-multi={cpu.multiCoreScore}
                        data-architecture={cpu.architecture}
                        data-cores={cpu.cores}
                        data-threads={cpu.threads}
                        data-year={cpu.releaseYear}
                      >
                        {cpu.brand} {cpu.name}
                      </option>
                    ))
                  }
                </select>

                <div class="smart-select" data-picker="cpu">
                  <button type="button" class="smart-trigger" aria-expanded="false">
                    <span>
                      <small>Selected processor</small>
                      <strong id="cpuTriggerText">Select your CPU</strong>
                    </span>
                    <span class="trigger-arrow">⌄</span>
                  </button>

                  <div class="smart-panel" hidden>
                    <div class="smart-search-wrap">
                      <span class="search-icon">⌕</span>
                      <input
                        id="cpuSearch"
                        class="smart-search"
                        type="search"
                        placeholder="Search Ryzen, Core i5, 7800X3D..."
                        autocomplete="off"
                      />
                    </div>

                    <div class="smart-options" id="cpuOptions">
                      <div class="option-section" data-popular-section>
                        <div class="option-section-title">Popular CPUs</div>
                        {
                          popularCpus.map((cpu) => (
                            <button
                              type="button"
                              class="smart-option popular-option"
                              data-value={cpu.id}
                              data-brand={cpu.brand}
                              data-search={`${cpu.brand} ${cpu.name} ${cpu.architecture}`.toLowerCase()}
                            >
                              <span class="option-main">
                                <span class="option-brand">{cpu.brand}</span>
                                <strong>{cpu.name}</strong>
                                <small>
                                  {cpu.architecture} · {cpu.cores} cores / {cpu.threads} threads · Released {cpu.releaseYear}
                                </small>
                              </span>
                              <span class="popular-tag">Popular</span>
                            </button>
                          ))
                        }
                      </div>

                      <div class="option-section">
                        <div class="option-section-title">All CPUs</div>
                        {
                          sortedCpus.map((cpu) => (
                            <button
                              type="button"
                              class="smart-option"
                              data-value={cpu.id}
                              data-brand={cpu.brand}
                              data-search={`${cpu.brand} ${cpu.name} ${cpu.architecture}`.toLowerCase()}
                            >
                              <span class="option-main">
                                <span class="option-brand">{cpu.brand}</span>
                                <strong>{cpu.name}</strong>
                                <small>
                                  {cpu.architecture} · {cpu.cores} cores / {cpu.threads} threads · Released {cpu.releaseYear}
                                </small>
                              </span>
                            </button>
                          ))
                        }
                      </div>
                    </div>

                    <p class="no-results" id="cpuNoResults" hidden>No matching processors found.</p>
                  </div>
                </div>
              </div>

              <div class="hardware-picker-block">
                <div class="picker-topline">
                  <div>
                    <span class="picker-kicker">GRAPHICS CARD</span>
                    <h3>Choose your GPU</h3>
                  </div>

                  <div class="brand-segments" data-brand-group="gpu">
                    <button type="button" class="brand-chip active" data-brand="">All</button>
                    <button type="button" class="brand-chip" data-brand="NVIDIA">NVIDIA</button>
                    <button type="button" class="brand-chip" data-brand="AMD">AMD Radeon</button>
                    <button type="button" class="brand-chip" data-brand="Intel">Intel Arc</button>
                  </div>
                </div>

                <select id="gpuBrand" class="native-control" aria-hidden="true" tabindex="-1">
                  <option value="">All GPU brands</option>
                  <option value="NVIDIA">NVIDIA</option>
                  <option value="AMD">AMD Radeon</option>
                  <option value="Intel">Intel Arc</option>
                </select>

                <select id="gpu" class="native-control" aria-hidden="true" tabindex="-1">
                  <option value="">Select your GPU</option>
                  {
                    sortedGpus.map((gpu) => (
                      <option
                        value={gpu.id}
                        data-brand={gpu.brand}
                        data-score={gpu.score}
                        data-gaming={gpu.gamingScore}
                        data-fps1080={gpu.rasterFps1080}
                        data-fps1440={gpu.rasterFps1440}
                        data-fps4k={gpu.rasterFps4k}
                        data-pairing-index={gpu.pairingIndex}
                        data-pairing-status={gpu.pairingIndexStatus}
                        data-data-quality={gpu.dataQuality}
                        data-benchmark-status={gpu.rasterBenchmarkStatus}
                        data-render={gpu.renderScore}
                        data-rt={gpu.rayTracingScore}
                        data-architecture={gpu.architecture}
                        data-vram={gpu.vramGB}
                        data-year={gpu.releaseYear}
                      >
                        {gpu.brand} {gpu.name}
                      </option>
                    ))
                  }
                </select>

                <div class="smart-select" data-picker="gpu">
                  <button type="button" class="smart-trigger" aria-expanded="false">
                    <span>
                      <small>Selected graphics card</small>
                      <strong id="gpuTriggerText">Select your GPU</strong>
                    </span>
                    <span class="trigger-arrow">⌄</span>
                  </button>

                  <div class="smart-panel" hidden>
                    <div class="smart-search-wrap">
                      <span class="search-icon">⌕</span>
                      <input
                        id="gpuSearch"
                        class="smart-search"
                        type="search"
                        placeholder="Search RTX 4070, RX 7800 XT..."
                        autocomplete="off"
                      />
                    </div>

                    <div class="smart-options" id="gpuOptions">
                      <div class="option-section" data-popular-section>
                        <div class="option-section-title">Popular GPUs</div>
                        {
                          popularGpus.map((gpu) => (
                            <button
                              type="button"
                              class="smart-option popular-option"
                              data-value={gpu.id}
                              data-brand={gpu.brand}
                              data-search={`${gpu.brand} ${gpu.name} ${gpu.architecture}`.toLowerCase()}
                            >
                              <span class="option-main">
                                <span class="option-brand">{gpu.brand}</span>
                                <strong>{gpu.name}</strong>
                                <small>
                                  {gpu.architecture} · {gpu.vramGB} GB VRAM · Released {gpu.releaseYear}
                                </small>
                              </span>
                              <span class="popular-tag">Popular</span>
                            </button>
                          ))
                        }
                      </div>

                      <div class="option-section">
                        <div class="option-section-title">All GPUs</div>
                        {
                          sortedGpus.map((gpu) => (
                            <button
                              type="button"
                              class="smart-option"
                              data-value={gpu.id}
                              data-brand={gpu.brand}
                              data-search={`${gpu.brand} ${gpu.name} ${gpu.architecture}`.toLowerCase()}
                            >
                              <span class="option-main">
                                <span class="option-brand">{gpu.brand}</span>
                                <strong>{gpu.name}</strong>
                                <small>
                                  {gpu.architecture} · {gpu.vramGB} GB VRAM · Released {gpu.releaseYear}
                                </small>
                              </span>
                            </button>
                          ))
                        }
                      </div>
                    </div>

                    <p class="no-results" id="gpuNoResults" hidden>No matching graphics cards found.</p>
                  </div>
                </div>
              </div>

              <div class="choice-panel">
                <div class="choice-heading">
                  <span class="picker-kicker">RESOLUTION</span>
                  <h3>Choose your display resolution</h3>
                </div>

                <select id="resolution" class="native-control" aria-hidden="true" tabindex="-1">
                  <option value="1080p">1920 × 1080 — 1080p</option>
                  <option value="1440p">2560 × 1440 — 1440p</option>
                  <option value="4k">3840 × 2160 — 4K</option>
                </select>

                <div class="visual-choices resolution-choices" data-control="resolution">
                  <button type="button" class="visual-choice active" data-value="1080p">
                    <strong>1080p</strong>
                    <span>1920 × 1080</span>
                  </button>
                  <button type="button" class="visual-choice" data-value="1440p">
                    <strong>1440p</strong>
                    <span>2560 × 1440</span>
                  </button>
                  <button type="button" class="visual-choice" data-value="4k">
                    <strong>4K</strong>
                    <span>3840 × 2160</span>
                  </button>
                </div>
              </div>

              <div class="choice-panel">
                <div class="choice-heading">
                  <span class="picker-kicker">PRIMARY USE</span>
                  <h3>Choose your main workload</h3>
                </div>

                <select id="purpose" class="native-control" aria-hidden="true" tabindex="-1">
                  <option value="gaming">Gaming</option>
                  <option value="streaming">Gaming & Streaming</option>
                  <option value="editing">Video Editing</option>
                  <option value="productivity">Productivity</option>
                </select>

                <div class="visual-choices purpose-choices" data-control="purpose">
                  <button type="button" class="visual-choice active" data-value="gaming">
                    <span class="choice-icon">G</span>
                    <strong>Gaming</strong>
                    <span>FPS & graphics</span>
                  </button>
                  <button type="button" class="visual-choice" data-value="streaming">
                    <span class="choice-icon">S</span>
                    <strong>Gaming + Stream</strong>
                    <span>Play and broadcast</span>
                  </button>
                  <button type="button" class="visual-choice" data-value="editing">
                    <span class="choice-icon">E</span>
                    <strong>Video Editing</strong>
                    <span>Render & timeline</span>
                  </button>
                  <button type="button" class="visual-choice" data-value="productivity">
                    <span class="choice-icon">P</span>
                    <strong>Productivity</strong>
                    <span>Work & multitask</span>
                  </button>
