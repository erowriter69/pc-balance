  function selectedMetric(
    select: HTMLSelectElement | null,
    metric: string,
    fallback = "score"
  ) {
    const option = select?.selectedOptions?.[0];
    if (!option) return 0;

    const value = option.dataset[metric as keyof DOMStringMap];
    const fallbackValue = option.dataset[fallback as keyof DOMStringMap];

    return Number(value || fallbackValue || 0);
  }

  function selectedName(select: HTMLSelectElement | null) {
    return select?.selectedOptions?.[0]?.textContent?.trim() || "";
  }

  function clamp(value: number, min: number, max: number) {
    return Math.min(Math.max(value, min), max);
  }

  function getMatchLabel(bottleneck: number) {
    if (bottleneck <= 5) return "Excellent";
    if (bottleneck <= 10) return "Very Good";
    if (bottleneck <= 16) return "Good";
    if (bottleneck <= 24) return "Fair";
    return "Mismatched";
  }

  function getBuildGrade(score: number) {
    if (score >= 94) return "Elite";
    if (score >= 88) return "Excellent";
    if (score >= 80) return "Very Good";
    if (score >= 70) return "Good";
    if (score >= 60) return "Fair";
    return "Entry";
  }

  function getConfidenceLabel(score: number) {
    if (score >= 88) return `High · ${score}%`;
    if (score >= 76) return `Good · ${score}%`;
    if (score >= 62) return `Moderate · ${score}%`;
    return `Limited · ${score}%`;
  }

  function benchmarkStatusScore(
    type: "cpu" | "gpu",
    benchmarkStatus: string,
    pairingStatus: string
  ) {
    const b = benchmarkStatus.toLowerCase();
    const p = pairingStatus.toLowerCase();

    if (type === "cpu") {
      if (b === "validated") return 94;
      if (b === "derived") return 86;
      if (p.includes("provisional-calibrated")) return 68;
      if (b === "provisional") return 58;
      return 60;
    }

    if (b === "validated") return 95;
    if (b === "legacy-bridged") return 78;
    if (p.includes("legacy")) return 74;
    if (b === "provisional") return 56;
    return 60;
  }

  function buildEstimateConfidence(args: {
    cpuBenchmarkStatus: string;
    cpuPairingStatus: string;
    gpuBenchmarkStatus: string;
    gpuPairingStatus: string;
    cpuYear: number;
    gpuYear: number;
    purpose: string;
    bottleneck: number;
    fps: string;
    ram: string;
    hasNativeGpuScaling: boolean;
  }) {
    const cpuEvidence = benchmarkStatusScore(
      "cpu",
      args.cpuBenchmarkStatus,
      args.cpuPairingStatus
    );

    const gpuEvidence = benchmarkStatusScore(
      "gpu",
      args.gpuBenchmarkStatus,
      args.gpuPairingStatus
    );

    let score = Math.round(
      cpuEvidence * 0.52 +
      gpuEvidence * 0.48
    );

    if (args.purpose === "gaming" && args.hasNativeGpuScaling) score += 3;
    if (args.fps) score += 3;
    else score -= 2;
    if (args.ram) score += 1;

    if (args.cpuYear && args.cpuYear < 2017) score -= 5;
    if (args.gpuYear && args.gpuYear < 2017) score -= 6;

    if (args.bottleneck === 0) score -= 2;
    else if (args.bottleneck <= 10) score -= 4;
    else if (args.bottleneck >= 30) score += 2;

    score = clamp(score, 45, 96);

    let margin = Math.round(
      3 +
      (100 - score) * 0.11 +
      (args.bottleneck <= 10 ? 2 : 0)
    );

    margin = clamp(margin, 4, 13);

    const low = Math.max(0, args.bottleneck - margin);
    const high = Math.min(80, args.bottleneck + margin);

    return {
      score,
      margin,
      low,
      high,
      label: getConfidenceLabel(score)
    };
  }

  function getRamMessage(value: string) {
    if (!value) return "Not selected";
    if (value === "8") return "8 GB may limit modern workloads";
    if (value === "16") return "16 GB is a solid baseline";
    if (value === "32") return "32 GB is excellent for most users";
    if (value === "64") return "64 GB suits heavy workloads";
    return "128 GB+ is workstation-class capacity";
  }

  function getExperience(
    limitingHeadroom: number,
    resolution: string,
    purpose: string
  ) {
    if (purpose === "productivity") {
      if (limitingHeadroom >= 82) return "Excellent general productivity";
      if (limitingHeadroom >= 68) return "Very good everyday productivity";
      if (limitingHeadroom >= 55) return "Good for normal desktop work";
      return "Better suited to lighter workloads";
    }

    if (purpose === "editing") {
      if (limitingHeadroom >= 82) return "Excellent editing headroom";
      if (limitingHeadroom >= 68) return "Very good for mainstream editing";
      if (limitingHeadroom >= 55) return "Good for moderate editing";
      return "Best for lighter editing projects";
    }

    const resolutionName =
      resolution === "4k" ? "4K" : resolution === "1440p" ? "1440p" : "1080p";

    if (limitingHeadroom >= 88) return `Excellent for ${resolutionName}`;
    if (limitingHeadroom >= 74) return `Very good for ${resolutionName}`;
    if (limitingHeadroom >= 62) return `Good for ${resolutionName}`;
    if (limitingHeadroom >= 50) return `Usable for ${resolutionName} with tuned settings`;
    return `${resolutionName} may require lower settings`;
  }

  function profileRating(score: number) {
    if (!score) return "—";
    if (score >= 95) return `Elite · ${score}/100`;
    if (score >= 85) return `Excellent · ${score}/100`;
    if (score >= 75) return `Very Good · ${score}/100`;
    if (score >= 65) return `Good · ${score}/100`;
    if (score >= 50) return `Moderate · ${score}/100`;
    return `Entry · ${score}/100`;
  }

  function updateCpuProfile() {
    const option = cpuSelect?.selectedOptions?.[0];

    if (!option || !option.value) {
      if (cpuProfileName) cpuProfileName.textContent = "Select a CPU";
      if (cpuArchitecture) cpuArchitecture.textContent = "—";
      if (cpuCoresThreads) cpuCoresThreads.textContent = "—";
      if (cpuYear) cpuYear.textContent = "—";
      if (cpuGamingProfile) cpuGamingProfile.textContent = "—";
      if (cpuProductivityProfile) cpuProductivityProfile.textContent = "—";
      if (cpuSingleProfile) cpuSingleProfile.textContent = "—";
      return;
    }

    if (cpuProfileName) cpuProfileName.textContent = option.textContent?.trim() || "Selected CPU";
    if (cpuArchitecture) cpuArchitecture.textContent = option.dataset.architecture || "—";
    if (cpuCoresThreads) {
      const cores = option.dataset.cores || "—";
      const threads = option.dataset.threads || "—";
      cpuCoresThreads.textContent = `${cores} / ${threads}`;
    }
    if (cpuYear) cpuYear.textContent = option.dataset.year || "—";
    if (cpuGamingProfile) cpuGamingProfile.textContent = profileRating(Number(option.dataset.gaming || 0));
    if (cpuProductivityProfile) cpuProductivityProfile.textContent = profileRating(Number(option.dataset.productivity || 0));
    if (cpuSingleProfile) cpuSingleProfile.textContent = profileRating(Number(option.dataset.single || 0));
  }

  function updateGpuProfile() {
    const option = gpuSelect?.selectedOptions?.[0];

    if (!option || !option.value) {
      if (gpuProfileName) gpuProfileName.textContent = "Select a GPU";
      if (gpuArchitecture) gpuArchitecture.textContent = "—";
      if (gpuVram) gpuVram.textContent = "—";
      if (gpuYear) gpuYear.textContent = "—";
      if (gpuGamingProfile) gpuGamingProfile.textContent = "—";
      if (gpuRenderProfile) gpuRenderProfile.textContent = "—";
      if (gpuRtProfile) gpuRtProfile.textContent = "—";
      return;
    }

    if (gpuProfileName) gpuProfileName.textContent = option.textContent?.trim() || "Selected GPU";
    if (gpuArchitecture) gpuArchitecture.textContent = option.dataset.architecture || "—";
    if (gpuVram) gpuVram.textContent = option.dataset.vram ? `${option.dataset.vram} GB` : "—";
    if (gpuYear) gpuYear.textContent = option.dataset.year || "—";
    if (gpuGamingProfile) gpuGamingProfile.textContent = profileRating(Number(option.dataset.gaming || 0));
    if (gpuRenderProfile) gpuRenderProfile.textContent = profileRating(Number(option.dataset.render || 0));
    if (gpuRtProfile) gpuRtProfile.textContent = profileRating(Number(option.dataset.rt || 0));
  }

  function closeSmartPanels(except?: Element | null) {
    document.querySelectorAll(".smart-select").forEach((picker) => {
      if (picker === except) return;

      const trigger = picker.querySelector(".smart-trigger") as HTMLButtonElement | null;
      const panel = picker.querySelector(".smart-panel") as HTMLElement | null;
      const block = picker.closest(".hardware-picker-block");

      picker.classList.remove("open");
      block?.classList.remove("open-picker");

      if (trigger) trigger.setAttribute("aria-expanded", "false");
      if (panel) panel.hidden = true;
    });
  }

  function syncSmartPicker(type: "cpu" | "gpu") {
    const select = type === "cpu" ? cpuSelect : gpuSelect;
    const triggerText = document.getElementById(`${type}TriggerText`);
    const picker = document.querySelector(`[data-picker="${type}"]`);
    if (!select || !picker) return;

    const selected = select.selectedOptions?.[0];
    if (triggerText) {
      triggerText.textContent =
        selected?.value ? selected.textContent?.trim() || "Selected" : `Select your ${type.toUpperCase()}`;
    }

    picker.querySelectorAll(".smart-option").forEach((option) => {
      option.classList.toggle(
        "selected",
        (option as HTMLElement).dataset.value === select.value
      );
    });
  }

  function applyHardwarePickerFilter(type: "cpu" | "gpu") {
    const picker = document.querySelector(`[data-picker="${type}"]`);
    const brandSelect = type === "cpu" ? cpuBrandSelect : gpuBrandSelect;
    const input = document.getElementById(`${type}Search`) as HTMLInputElement | null;
    const noResults = document.getElementById(`${type}NoResults`);
    if (!picker) return;

    const query = (input?.value || "").trim().toLowerCase();
    const brand = brandSelect?.value || "";
    let visible = 0;

    picker.querySelectorAll(".smart-option").forEach((node) => {
      const option = node as HTMLButtonElement;
      const matchesBrand = !brand || option.dataset.brand === brand;
      const matchesSearch = !query || (option.dataset.search || "").includes(query);
      option.hidden = !(matchesBrand && matchesSearch);
      if (!option.hidden) visible += 1;
    });

    const popularSection = picker.querySelector("[data-popular-section]") as HTMLElement | null;
    if (popularSection) {
      popularSection.hidden = Boolean(query);
    }

    if (noResults) noResults.hidden = visible !== 0;
  }

  document.querySelectorAll(".smart-select").forEach((picker) => {
    const type = (picker as HTMLElement).dataset.picker as "cpu" | "gpu";
    const trigger = picker.querySelector(".smart-trigger") as HTMLButtonElement | null;
    const panel = picker.querySelector(".smart-panel") as HTMLElement | null;
    const input = picker.querySelector(".smart-search") as HTMLInputElement | null;
    const select = type === "cpu" ? cpuSelect : gpuSelect;

    trigger?.addEventListener("click", () => {
      const opening = panel?.hidden ?? true;
      const block = picker.closest(".hardware-picker-block");

      closeSmartPanels(picker);

      if (panel) panel.hidden = !opening;
      trigger.setAttribute("aria-expanded", opening ? "true" : "false");

      picker.classList.toggle("open", opening);
      block?.classList.toggle("open-picker", opening);

      if (opening) {
        applyHardwarePickerFilter(type);
        window.setTimeout(() => input?.focus(), 20);
      }
    });

    input?.addEventListener("input", () => applyHardwarePickerFilter(type));

    picker.querySelectorAll(".smart-option").forEach((option) => {
      option.addEventListener("click", () => {
        if (!select) return;
        select.value = (option as HTMLElement).dataset.value || "";
        select.dispatchEvent(new Event("change", { bubbles: true }));
        syncSmartPicker(type);
        if (panel) panel.hidden = true;
        trigger?.setAttribute("aria-expanded", "false");
        picker.classList.remove("open");
        picker.closest(".hardware-picker-block")?.classList.remove("open-picker");
      });
    });
  });

  document.addEventListener("click", (event) => {
    const target = event.target as Node;
    if (!document.querySelector(".smart-select")?.contains(target)) {
      const insideAny = Array.from(document.querySelectorAll(".smart-select")).some((el) => el.contains(target));
      if (!insideAny) closeSmartPanels();
    }
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") closeSmartPanels();
  });

  document.querySelectorAll("[data-brand-group]").forEach((group) => {
    group.querySelectorAll(".brand-chip").forEach((button) => {
      button.addEventListener("click", () => {
        const type = (group as HTMLElement).dataset.brandGroup as "cpu" | "gpu";
        const brandSelect = type === "cpu" ? cpuBrandSelect : gpuBrandSelect;
        if (!brandSelect) return;

        group.querySelectorAll(".brand-chip").forEach((item) => item.classList.remove("active"));
        button.classList.add("active");
        brandSelect.value = (button as HTMLElement).dataset.brand || "";
        brandSelect.dispatchEvent(new Event("change", { bubbles: true }));
        applyHardwarePickerFilter(type);
      });
    });
  });

  document.querySelectorAll("[data-control]").forEach((group) => {
    group.querySelectorAll("[data-value]").forEach((button) => {
      button.addEventListener("click", () => {
        const controlId = (group as HTMLElement).dataset.control || "";
        const select = document.getElementById(controlId) as HTMLSelectElement | null;
        if (!select) return;

        group.querySelectorAll("[data-value]").forEach((item) => item.classList.remove("active"));
        button.classList.add("active");
        select.value = (button as HTMLElement).dataset.value || "";
        select.dispatchEvent(new Event("change", { bubbles: true }));
      });
    });
  });

  function filterHardwareByBrand(
    brandSelect: HTMLSelectElement | null,
    hardwareSelect: HTMLSelectElement | null
  ) {
    if (!brandSelect || !hardwareSelect) return;

    const chosenBrand = brandSelect.value;

    Array.from(hardwareSelect.options).forEach((option, index) => {
      if (index === 0) {
        option.hidden = false;
        return;
      }

      const optionBrand = option.dataset.brand || "";
      option.hidden = Boolean(chosenBrand && optionBrand !== chosenBrand);
    });

    const selectedOption = hardwareSelect.selectedOptions?.[0];
    if (
      selectedOption &&
      selectedOption.value &&
      chosenBrand &&
      selectedOption.dataset.brand !== chosenBrand
    ) {
      hardwareSelect.value = "";
    }
  }

  cpuBrandSelect?.addEventListener("change", () => {
    filterHardwareByBrand(cpuBrandSelect, cpuSelect);
    applyHardwarePickerFilter("cpu");
    syncSmartPicker("cpu");
    updateCpuProfile();
  });

  gpuBrandSelect?.addEventListener("change", () => {
    filterHardwareByBrand(gpuBrandSelect, gpuSelect);
    applyHardwarePickerFilter("gpu");
    syncSmartPicker("gpu");
    updateGpuProfile();
  });

  cpuSelect?.addEventListener("change", () => {
    updateCpuProfile();
    syncSmartPicker("cpu");
  });

  gpuSelect?.addEventListener("change", () => {
    updateGpuProfile();
    syncSmartPicker("gpu");
  });

  filterHardwareByBrand(cpuBrandSelect, cpuSelect);
  filterHardwareByBrand(gpuBrandSelect, gpuSelect);
  updateCpuProfile();
  updateGpuProfile();
  syncSmartPicker("cpu");
  syncSmartPicker("gpu");

  function qualitative(score: number) {
    if (score >= 92) return "Elite";
    if (score >= 82) return "Excellent";
    if (score >= 70) return "Very Good";
    if (score >= 58) return "Good";
    if (score >= 45) return "Moderate";
    return "Limited";
  }

  function topUpgradeNames(
    select: HTMLSelectElement | null,
    currentScore: number,
    metric = "gaming",
    max = 3,
    sameBrand = false
  ) {
    if (!select) return [];

    const currentOption = select.selectedOptions?.[0];
    const currentBrand = currentOption?.dataset.brand || "";

    return Array.from(select.options)
      .filter((option) => {
        if (!option.value) return false;

        const optionScore = Number(
          option.dataset[metric as keyof DOMStringMap] ||
          option.dataset.score ||
          0
        );

        const benchmarkStatus = option.dataset.benchmarkStatus || "";
        const validatedEnough =
          metric !== "pairingIndex" ||
          benchmarkStatus === "validated" ||
          benchmarkStatus === "derived" ||
          benchmarkStatus === "legacy-bridged";

        const clearsUpgradeGap =
          metric === "pairingIndex"
            ? optionScore >= currentScore * 1.10
            : optionScore >= currentScore + 7;

        const brandAllowed =
          !sameBrand || option.dataset.brand === currentBrand;

        return validatedEnough && clearsUpgradeGap && brandAllowed;
      })
      .sort(
        (a, b) =>
          Number(
            a.dataset[metric as keyof DOMStringMap] ||
            a.dataset.score ||
            0
          ) -
          Number(
            b.dataset[metric as keyof DOMStringMap] ||
            b.dataset.score ||
            0
          )
      )
      .slice(0, max)
      .map((option) => option.textContent?.trim() || "")
      .filter(Boolean);
  }

  function retailerUrl(retailer: "amazon" | "newegg", query: string) {
    const encoded = encodeURIComponent(query);

    if (retailer === "amazon") {
      return `https://www.amazon.com/s?k=${encoded}`;
    }

    return `https://www.newegg.com/p/pl?d=${encoded}`;
  }

  function getUpgradeCandidates(
    select: HTMLSelectElement | null,
    currentScore: number,
    metric = "gaming",
    max = 2,
    sameBrand = false
  ) {
    if (!select) return [];

    const currentOption = select.selectedOptions?.[0];
    const currentBrand = currentOption?.dataset.brand || "";

    return Array.from(select.options)
      .filter((option) => {
        if (!option.value) return false;

        const score = Number(
          option.dataset[metric as keyof DOMStringMap] ||
          option.dataset.score ||
          0
        );

        const benchmarkStatus = option.dataset.benchmarkStatus || "";

        // Never recommend a provisional component as an "upgrade".
        const validatedEnough =
          benchmarkStatus === "validated" ||
          benchmarkStatus === "derived" ||
          benchmarkStatus === "legacy-bridged";

        return (
          validatedEnough &&
          score >= currentScore * 1.10 &&
          (!sameBrand || option.dataset.brand === currentBrand)
        );
      })
      .sort(
        (a, b) =>
          Number(
            a.dataset[metric as keyof DOMStringMap] ||
            a.dataset.score ||
            0
          ) -
          Number(
            b.dataset[metric as keyof DOMStringMap] ||
            b.dataset.score ||
            0
          )
      )
      .slice(0, max)
      .map((option) => {
        const score = Number(
          option.dataset[metric as keyof DOMStringMap] ||
          option.dataset.score ||
          0
        );

        return {
          name: option.textContent?.trim() || "Upgrade option",
          score,
          relativeGain: Math.max(
            1,
            Math.round(((score - currentScore) / Math.max(currentScore, 1)) * 100)
          )
        };
      });
  }

  function ramGuidance(purpose: string) {
    if (purpose === "editing") {
      return {
        minimum: "32 GB",
        recommended: "64 GB",
        heavy: "128 GB",
        minimumText: "Suitable for mainstream editing projects and moderate timelines.",
        recommendedText: "A stronger target for larger projects, multitasking, and heavier media.",
        heavyText: "Useful for demanding professional projects, large caches, and workstation use."
      };
    }

    if (purpose === "streaming") {
      return {
        minimum: "16 GB",
        recommended: "32 GB",
        heavy: "64 GB",
        minimumText: "Usable for gaming plus a light streaming setup.",
        recommendedText: "A comfortable target for gaming, streaming, browser tabs, and background tools.",
        heavyText: "Useful for heavier multitasking, editing, and creator workflows alongside gaming."
      };
    }

    if (purpose === "productivity") {
      return {
        minimum: "16 GB",
        recommended: "32 GB",
        heavy: "64 GB",
        minimumText: "Enough for normal office work, browsing, and everyday multitasking.",
        recommendedText: "A strong all-round target for heavier multitasking and professional applications.",
        heavyText: "Useful for large datasets, virtual machines, creative work, and heavy multitasking."
      };
    }

    return {
      minimum: "16 GB",
      recommended: "32 GB",
      heavy: "64 GB",
      minimumText: "A practical minimum for modern gaming and everyday PC use.",
      recommendedText: "The best all-round target for modern games, background apps, and future headroom.",
      heavyText: "Useful for streaming, heavy modding, creation work, and demanding multitasking."
    };
  }

  function gamingResolutionAnalysis(
    cpuPairingIndex: number,
    gpuPairingIndex: number,
    fpsValue: string,
    resolutionKey: "1080p" | "1440p" | "4k",
    gpuFps1080 = 0,
    gpuFps1440 = 0,
    gpuFps4k = 0
  ) {
    /*
      PC BALANCE GAMING ENGINE V2
      ---------------------------
      1. CPU and GPU still meet on the benchmark-calibrated pairing domain.
      2. CPU-limited systems keep the proven resolution-relief curve.
      3. GPU-limited systems use a nonlinear calibration curve so small but
         real mismatches are not understated.
      4. Actual native-resolution GPU raster retention is used as a secondary
         correction when validated FPS data exists.
      5. A dead zone prevents tiny benchmark noise from becoming a fake
         bottleneck percentage.

      The displayed percentage is a comparative pairing estimate, not a
      literal universal utilization measurement.
    */

    const BALANCE_GPU_TO_CPU = 54.7 / 66.0;
    const DEADZONE = 1.15;

    const cpuIndex = Math.max(cpuPairingIndex, 1);
    const gpuIndex = Math.max(gpuPairingIndex, 1);

    const baseRatio =
      gpuIndex / (cpuIndex * BALANCE_GPU_TO_CPU);

    let ratio = baseRatio;

    if (baseRatio >= 1) {
      /*
        CPU-side limitation:
        Higher resolutions normally reduce CPU pressure because the GPU has
        more work per frame. These factors were retained from the previous
        engine because they matched our high-end GPU scaling sanity tests.
      */
      const cpuRelief = {
        "1080p": 1.00,
        "1440p": 1.47,
        "4k": 2.60
      };

      ratio = baseRatio / cpuRelief[resolutionKey];

      // Resolution can relieve an existing CPU limitation, but the resolution
      // adjustment alone must not manufacture a new GPU bottleneck. Once the
      // balance point is reached, treat the pairing as balanced.
      if (ratio < 1) {
        ratio = 1;
      }
    } else {
      /*
        GPU-side limitation:
        A nearly-balanced PC should not suddenly become a large "bottleneck"
        at 1440p simply because every GPU produces fewer FPS there. Instead,
        resolution pressure grows with how far the GPU already trails the CPU.

        4K has an unavoidable baseline graphics penalty, while 1440p applies
        mainly to already GPU-heavy pairings.
      */
      const weakness = clamp(1 - baseRatio, 0, 0.85);

      const gpuResolutionPenalty = {
        "1080p": 1.00,
        "1440p": 1.00 + weakness * 0.90,
        "4k": 1.40 + weakness * 1.00
      };

      ratio =
        baseRatio /
        gpuResolutionPenalty[resolutionKey];

      /*
        Native-resolution retention correction.
        RTX 3060 is used only as a neutral retention anchor because it was one
        of our independently checked balanced baseline combinations.

        If a GPU loses unusually more performance than that anchor at the
        selected resolution, the GPU-side result gets a modest additional
        penalty. The correction is deliberately capped.
      */
      if (
        resolutionKey !== "1080p" &&
        gpuFps1080 > 0
      ) {
        const selectedFps =
          resolutionKey === "1440p"
            ? gpuFps1440
            : gpuFps4k;

        if (selectedFps > 0) {
          const actualRetention =
            selectedFps / gpuFps1080;

          const neutralRetention =
            resolutionKey === "1440p"
              ? 41.9 / 61.5
              : 22.2 / 61.5;

          const retentionCorrection = clamp(
            neutralRetention /
              Math.max(actualRetention, 0.05),
            0.92,
            1.12
          );

          ratio /= retentionCorrection;
        }
      }
    }

    /*
      High-refresh targets shift pressure back toward the CPU.
      These are intentionally mild because a selected target FPS is context,
      not proof that every game will reach that frame rate.
    */
    const fpsCpuPressure: Record<string, number> = {
      "60": 1.00,
      "75": 1.01,
      "120": 1.05,
      "144": 1.08,
      "165": 1.11,
      "240": 1.18
    };

    if (fpsValue) {
      ratio *= fpsCpuPressure[fpsValue] || 1;
    }

    // Preserve the original limiting side after contextual adjustments.
    // Context can reduce a mismatch to balanced, but should not invert it
    // without component data actually supporting the opposite direction.
    if (baseRatio >= 1 && ratio < 1) {
      ratio = 1;
    } else if (baseRatio < 1 && ratio > 1) {
      ratio = 1;
    }

    let mismatch = 0;
    let cpuLimit = false;
    let gpuLimit = false;

    if (ratio > DEADZONE) {
      cpuLimit = true;

      const distance =
        Math.log(ratio / DEADZONE);

      mismatch = Math.round(
        distance * 47.5
      );
    } else if (ratio < 1 / DEADZONE) {
      gpuLimit = true;

      const distance =
        Math.log(
          (1 / ratio) / DEADZONE
        );

      /*
        Nonlinear GPU-side calibration:
        The old linear curve systematically understated mild GPU mismatches
        while already matching severe examples well. This exponent curve is
        calibrated to preserve the severe i5-12400F + RX 580 case while
        correcting mild cases such as Core Ultra 7 270K Plus + RTX 5060.
      */
      mismatch = Math.round(
        52.61 *
          Math.pow(
            Math.max(distance, 0),
            0.607
          )
      );
    }

    mismatch = clamp(mismatch, 0, 80);

    if (mismatch < 5) {
      mismatch = 0;
      cpuLimit = false;
      gpuLimit = false;
    }

    const status =
      mismatch === 0
        ? "Excellent"
        : mismatch <= 10
          ? "Very Good"
          : mismatch <= 18
            ? "Good"
            : mismatch <= 30
              ? "Fair"
              : "Limited";

    let text = "";
    let limit = "";

    if (mismatch === 0) {
      text =
        "No major CPU–GPU pairing mismatch stands out at this resolution. The limiting component can still change by game, graphics settings, and target frame rate.";
      limit = "No major mismatch";
    } else if (cpuLimit) {
      text =
        "The graphics card is fast enough to expose processor limits more often at this resolution, especially in CPU-heavy and high-refresh games.";
      limit = "CPU more likely to limit";
    } else {
      text =
        "The graphics card has less gaming headroom than the processor for this target. The gap becomes more important as resolution, visual quality, or ray-tracing demand increases.";
      limit = "GPU more likely to limit";
    }

    return {
      mismatch,
      status,
      text,
      limit,
      cpuLimit,
      gpuLimit,
      pairingRatio: ratio
    };
  }

  function resolutionAnalysis(
    cpuScore: number,
    gpuScore: number,
    purposeKey: string,
    fpsValue: string,
    resolutionKey: "1080p" | "1440p" | "4k",
    cpuPairingIndex = 0,
    gpuPairingIndex = 0,
    gpuFps1080 = 0,
    gpuFps1440 = 0,
    gpuFps4k = 0
  ) {
    if (purposeKey === "gaming" && cpuPairingIndex && gpuPairingIndex) {
      return gamingResolutionAnalysis(
        cpuPairingIndex,
        gpuPairingIndex,
        fpsValue,
        resolutionKey,
        gpuFps1080,
        gpuFps1440,
        gpuFps4k
      );
    }

    const resolutionMap = {
      "1080p": { cpu: 1.08, gpu: 0.96 },
      "1440p": { cpu: 0.99, gpu: 1.07 },
      "4k": { cpu: 0.91, gpu: 1.22 }
    };

    const purposeMap = {
      gaming: { cpu: 1.00, gpu: 1.00 },
      streaming: { cpu: 1.10, gpu: 1.03 },
      editing: { cpu: 1.09, gpu: 1.06 },
      productivity: { cpu: 1.12, gpu: 0.84 }
    };

    const fpsMap: Record<string, { cpu: number; gpu: number }> = {
      "60": { cpu: 0.94, gpu: 0.98 },
      "75": { cpu: 0.98, gpu: 1.00 },
      "120": { cpu: 1.07, gpu: 1.03 },
      "144": { cpu: 1.13, gpu: 1.05 },
      "165": { cpu: 1.18, gpu: 1.07 },
      "240": { cpu: 1.31, gpu: 1.10 }
    };

    const r = resolutionMap[resolutionKey];
    const p =
      purposeMap[purposeKey as keyof typeof purposeMap] ||
      purposeMap.gaming;
    const f = fpsValue
      ? fpsMap[fpsValue] || { cpu: 1, gpu: 1 }
      : { cpu: 1, gpu: 1 };

    const cpuEff = cpuScore / (r.cpu * p.cpu * f.cpu);
    const gpuEff = gpuScore / (r.gpu * p.gpu * f.gpu);

    const stronger = Math.max(cpuEff, gpuEff);
    const weaker = Math.min(cpuEff, gpuEff);
    const raw =
      stronger > 0 ? ((stronger - weaker) / stronger) * 100 : 0;

    const mismatch = clamp(
      Math.max(1, Math.round(raw * 0.55)),
      1,
      45
    );

    const cpuLimit = cpuEff < gpuEff;
    const gpuLimit = gpuEff < cpuEff;
    const balanced = mismatch <= 5;

    const status =
      mismatch <= 5
        ? "Excellent"
        : mismatch <= 10
          ? "Very Good"
          : mismatch <= 16
            ? "Good"
            : mismatch <= 24
              ? "Fair"
              : "Mismatched";

    let text = "";
    let limit = "";

    if (balanced) {
      text =
        "No major CPU–GPU mismatch stands out for this workload.";
      limit = "No major mismatch";
    } else if (cpuLimit) {
      text =
        "The CPU becomes the more likely constraint for this workload.";
      limit = "CPU more likely to limit";
    } else {
      text =
        "The GPU becomes the more likely constraint for this workload.";
      limit = "GPU more likely to limit";
    }

    return {
      mismatch,
      status,
      text,
      limit,
      cpuLimit,
      gpuLimit,
      pairingRatio: 1
    };
  }

  function setResolutionCard(
    key: "1080p" | "1440p" | "4k",
    result: ReturnType<typeof resolutionAnalysis>,
    selectedResolution: string
  ) {
    const map = {
      "1080p": {
        card: resolution1080Card,
        status: resolution1080Status,
        text: resolution1080Text,
        percent: resolution1080Percent,
        limit: resolution1080Limit
      },
      "1440p": {
        card: resolution1440Card,
        status: resolution1440Status,
        text: resolution1440Text,
        percent: resolution1440Percent,
        limit: resolution1440Limit
      },
      "4k": {
        card: resolution4kCard,
        status: resolution4kStatus,
        text: resolution4kText,
        percent: resolution4kPercent,
        limit: resolution4kLimit
      }
    };

    const target = map[key];
    target.card?.classList.toggle(
      "selected-resolution",
      key === selectedResolution
    );

    if (target.status) target.status.textContent = result.status;
    if (target.text) target.text.textContent = result.text;
    if (target.percent) {
      target.percent.textContent = `${result.mismatch}% estimated mismatch`;
    }
    if (target.limit) target.limit.textContent = result.limit;
  }

  newCalculationButton?.addEventListener("click", () => {
    document.getElementById("calculator")?.scrollIntoView({
      behavior: "smooth",
      block: "start"
    });

    window.setTimeout(() => {
      document.querySelector('[data-picker="cpu"] .smart-trigger')?.dispatchEvent(
        new MouseEvent("click", { bubbles: true })
      );
    }, 450);
  });

  calculateButton?.addEventListener("click", () => {
    if (!cpuSelect?.value || !gpuSelect?.value) {
      alert("Please select both a CPU and GPU.");
      return;
    }

    const resolution = resolutionSelect?.value || "1080p";
    const purpose = purposeSelect?.value || "gaming";
    const ram = ramSelect?.value || "";
    const fps = fpsSelect?.value || "";

    const cpuGaming = selectedMetric(cpuSelect, "gaming");
    const cpuProductivity = selectedMetric(cpuSelect, "productivity");
    const cpuSingle = selectedMetric(cpuSelect, "single");
    const cpuMulti = selectedMetric(cpuSelect, "multi");

    const gpuGaming = selectedMetric(gpuSelect, "gaming");
    const gpuRender = selectedMetric(gpuSelect, "render");
    const gpuRayTracing = selectedMetric(gpuSelect, "rt");

    const cpuGamingIndex =
      selectedMetric(cpuSelect, "gamingIndex") || cpuGaming * 0.82;

    const cpuPairingIndex =
      selectedMetric(cpuSelect, "pairingIndex") || cpuGamingIndex;

    const gpuPairingIndex =
      selectedMetric(gpuSelect, "pairingIndex") || gpuGaming;

    const gpuFps1080 = selectedMetric(gpuSelect, "fps1080");
    const gpuFps1440 = selectedMetric(gpuSelect, "fps1440");
    const gpuFps4k = selectedMetric(gpuSelect, "fps4k");

    if (
      !cpuGaming ||
      !cpuProductivity ||
      !cpuSingle ||
      !cpuMulti ||
      !gpuGaming ||
      !gpuRender
    ) {
      alert("This hardware entry is missing performance data.");
      return;
    }

    /*
      V3 CONTEXT MODEL
      ----------------
      We do not treat one synthetic score as a literal bottleneck.
      First, CPU/GPU capability is blended for the selected workload.
      Then resolution, FPS and RAM alter the demand placed on each side.
      Finally, pairing balance and absolute component quality are scored
      separately so a balanced low-end PC cannot receive a fake 100/100.
    */

    let cpuScore = cpuGaming * 0.55 + cpuSingle * 0.30 + cpuMulti * 0.15;
    let gpuScore = gpuGaming;

    if (purpose === "streaming") {
      cpuScore =
        cpuGaming * 0.35 +
        cpuSingle * 0.15 +
        cpuMulti * 0.35 +
        cpuProductivity * 0.15;

      gpuScore = gpuGaming * 0.82 + gpuRender * 0.18;
    }

    if (purpose === "editing") {
      cpuScore =
        cpuProductivity * 0.45 +
        cpuMulti * 0.40 +
        cpuSingle * 0.15;

      gpuScore = gpuRender * 0.78 + gpuGaming * 0.22;
    }

    if (purpose === "productivity") {
      cpuScore =
        cpuProductivity * 0.45 +
        cpuSingle * 0.25 +
        cpuMulti * 0.30;

      gpuScore = gpuRender * 0.62 + gpuGaming * 0.38;
    }

    const resolutionProfile = {
      "1080p": {
        cpuDemand: 1.08,
        gpuDemand: 0.96,
        label: "1920 × 1080 (1080p)"
      },
      "1440p": {
        cpuDemand: 0.99,
        gpuDemand: 1.07,
        label: "2560 × 1440 (1440p)"
      },
      "4k": {
        cpuDemand: 0.91,
        gpuDemand: 1.22,
        label: "3840 × 2160 (4K)"
      }
    };

    const purposeProfile = {
      gaming: {
        cpuDemand: 1.00,
        gpuDemand: 1.00,
        label: "Gaming",
        cpuWeight: 0.42,
        gpuWeight: 0.58
      },
      streaming: {
        cpuDemand: 1.10,
        gpuDemand: 1.03,
        label: "Gaming & Streaming",
        cpuWeight: 0.50,
        gpuWeight: 0.50
      },
      editing: {
        cpuDemand: 1.09,
        gpuDemand: 1.06,
        label: "Video Editing",
        cpuWeight: 0.56,
        gpuWeight: 0.44
      },
      productivity: {
        cpuDemand: 1.12,
        gpuDemand: 0.84,
        label: "Productivity",
        cpuWeight: 0.68,
        gpuWeight: 0.32
      }
    };

    const fpsProfile: Record<string, { cpu: number; gpu: number }> = {
      "60": { cpu: 0.94, gpu: 0.98 },
      "75": { cpu: 0.98, gpu: 1.00 },
      "120": { cpu: 1.07, gpu: 1.03 },
      "144": { cpu: 1.13, gpu: 1.05 },
      "165": { cpu: 1.18, gpu: 1.07 },
      "240": { cpu: 1.31, gpu: 1.10 }
    };

    const resolutionFactors =
      resolutionProfile[resolution as keyof typeof resolutionProfile] ||
      resolutionProfile["1080p"];

    const purposeFactors =
      purposeProfile[purpose as keyof typeof purposeProfile] ||
      purposeProfile.gaming;

    const fpsFactors = fps
      ? fpsProfile[fps] || { cpu: 1, gpu: 1 }
      : { cpu: 1, gpu: 1 };

    let cpuEffective =
      cpuScore /
      (resolutionFactors.cpuDemand *
        purposeFactors.cpuDemand *
        fpsFactors.cpu);

    let gpuEffective =
      gpuScore /
      (resolutionFactors.gpuDemand *
        purposeFactors.gpuDemand *
        fpsFactors.gpu);

    let ramPenalty = 0;

    if (ram === "8") {
      cpuEffective *= 0.94;
      gpuEffective *= 0.98;
      ramPenalty = 5;
    } else if (ram === "16") {
      ramPenalty = 1;
    }

    let bottleneck = 0;
    let cpuIsLimit = false;
    let gpuIsLimit = false;

    if (purpose === "gaming" && cpuPairingIndex && gpuPairingIndex) {
      const gamingAnalysis = gamingResolutionAnalysis(
        cpuPairingIndex,
        gpuPairingIndex,
        fps,
        resolution as "1080p" | "1440p" | "4k",
        gpuFps1080,
        gpuFps1440,
        gpuFps4k
      );

      bottleneck = gamingAnalysis.mismatch;
      cpuIsLimit = gamingAnalysis.cpuLimit;
      gpuIsLimit = gamingAnalysis.gpuLimit;
    } else {
      const strongerEffective = Math.max(cpuEffective, gpuEffective);
      const weakerEffective = Math.min(cpuEffective, gpuEffective);

      const rawGap =
        strongerEffective > 0
          ? ((strongerEffective - weakerEffective) / strongerEffective) * 100
          : 0;

      bottleneck = Math.round(rawGap * 0.55);
      bottleneck = clamp(Math.max(1, bottleneck), 1, 45);

      cpuIsLimit = cpuEffective < gpuEffective;
      gpuIsLimit = gpuEffective < cpuEffective;
    }

    const balanced = bottleneck <= 5;

    const balanceQuality = clamp(100 - bottleneck * 1.45, 35, 99);

    const componentQuality =
      cpuScore * purposeFactors.cpuWeight +
      gpuScore * purposeFactors.gpuWeight;

    let buildScore = Math.round(
      componentQuality * 0.78 +
      balanceQuality * 0.22 -
      ramPenalty
    );

    // High target FPS and 4K expose absolute capability, not just balance.
    if (fps && Number(fps) >= 165 && componentQuality < 82) {
      buildScore -= 3;
    }

    if (resolution === "4k" && gpuScore < 82) {
      buildScore -= 4;
    }

    buildScore = clamp(buildScore, 45, 98);

    const matchLabel = getMatchLabel(bottleneck);
    const buildGrade = getBuildGrade(buildScore);

    /*
      Estimate confidence describes the evidence behind this exact result.
      It is separate from build quality and from the bottleneck percentage.
    */
    const cpuOption = cpuSelect.selectedOptions?.[0];
    const gpuOption = gpuSelect.selectedOptions?.[0];

    const cpuYear = Number(cpuOption?.dataset.year || 0);
    const gpuYear = Number(gpuOption?.dataset.year || 0);

    const cpuBenchmarkStatus =
      cpuOption?.dataset.benchmarkStatus || "";
    const cpuPairingStatus =
      cpuOption?.dataset.pairingStatus || "";

    const gpuBenchmarkStatus =
      gpuOption?.dataset.benchmarkStatus || "";
    const gpuPairingStatus =
      gpuOption?.dataset.pairingStatus || "";

    const hasNativeGpuScaling =
      gpuFps1080 > 0 &&
      gpuFps1440 > 0 &&
      gpuFps4k > 0 &&
      gpuBenchmarkStatus === "validated";

    const confidence = buildEstimateConfidence({
      cpuBenchmarkStatus,
      cpuPairingStatus,
      gpuBenchmarkStatus,
      gpuPairingStatus,
      cpuYear,
      gpuYear,
      purpose,
      bottleneck,
      fps,
      ram,
      hasNativeGpuScaling
    });

    const confidenceScore = confidence.score;

    const cpuName = selectedName(cpuSelect);
    const gpuName = selectedName(gpuSelect);

    let title = "";
    let type = "";
    let summary = "";
    let upgrade = "";

    if (balanced) {
      title = purpose === "gaming" ? "Well-Matched Gaming Pairing" : "Excellent Match";
      type =
        purpose === "gaming"
          ? "No significant CPU-side constraint detected"
          : "No significant CPU–GPU mismatch detected";
      summary =
        purpose === "gaming"
          ? `At ${resolutionFactors.label}, the benchmark-calibrated pairing model does not detect a meaningful CPU–GPU mismatch. ` +
            `The estimated mismatch is ${bottleneck}%, though the limiting component can still vary by game, settings, and target frame rate.`
          : `The CPU and GPU are closely matched for ${purposeFactors.label.toLowerCase()} at ${resolutionFactors.label}. ` +
            `The estimated ${bottleneck}% mismatch is small enough that the limiting component will often change from one application to another.`;

      upgrade =
        buildScore >= 84
          ? "There is no urgent CPU-or-GPU upgrade priority. Upgrade only if you are targeting a higher resolution, substantially higher frame rate, or a heavier workload."
          : "The pairing itself is balanced, but both components are in a lower performance tier. A future platform-wide upgrade may make more sense than replacing only one part.";
    } else if (cpuIsLimit) {
      title = "CPU-Limited Pairing";
      type = "The processor is the more likely limiting component";
      summary =
        `The processor has less relative headroom than the graphics card under these settings. ` +
        `The estimated ${bottleneck}% mismatch is most likely to appear in CPU-heavy games, simulation workloads, and high-refresh targets.`;

      upgrade =
        bottleneck <= 10
          ? "This remains a strong pairing. A CPU upgrade is optional and mainly worthwhile for high-refresh gaming or processor-heavy applications."
          : "The CPU is the first component to investigate if you want to reduce the mismatch. Check motherboard and socket compatibility before choosing a replacement.";
    } else {
      title = "GPU-Limited Pairing";
      type = "The graphics card is the more likely limiting component";
      summary =
        `The graphics card has less relative headroom than the processor under these settings. ` +
        `The estimated ${bottleneck}% mismatch is most likely to appear as resolution, visual quality, rendering load, or ray tracing demand increases.`;

      upgrade =
        bottleneck <= 10
          ? "This remains a strong pairing. A GPU upgrade is optional and would mainly help with higher resolutions, heavier graphics settings, or higher frame rates."
          : "The GPU is the clearest upgrade target if you want more performance at this resolution and workload.";
    }

    const fpsDescription = fps
      ? `${fps} FPS target included`
      : "No FPS target selected";

    if (resultTitle) resultTitle.textContent = title;
    if (resultPair) resultPair.textContent = `${cpuName} + ${gpuName}`;
    if (resultPercentage) resultPercentage.textContent = `${bottleneck}%`;
    if (resultType) resultType.textContent = type;
    if (resultText) resultText.textContent = summary;
    if (matchScore) matchScore.textContent = `${buildScore}/100`;
    if (overallMatch) overallMatch.textContent = matchLabel;
    if (resultResolution) resultResolution.textContent = resolutionFactors.label;
    if (resultPurpose) resultPurpose.textContent = purposeFactors.label;
    if (resultConfidence) {
      resultConfidence.textContent = confidence.label;
    }

    if (resultRange) {
      resultRange.textContent =
        bottleneck === 0
          ? `Expected range: 0–${confidence.high}% · varies by game`
          : `Expected range: ${confidence.low}–${confidence.high}% · varies by game`;
    }

    if (methodCpuScore) {
      methodCpuScore.textContent =
        purpose === "gaming"
          ? `${cpuPairingIndex.toFixed(1)} CPU pairing index`
          : `${Math.round(cpuScore)}/100 workload profile`;
    }

    if (methodGpuScore) {
      methodGpuScore.textContent =
        purpose === "gaming" && gpuPairingIndex
          ? `${gpuPairingIndex.toFixed(1)} GPU pairing index`
          : `${Math.round(gpuScore)}/100 workload profile`;
    }

    if (methodResolution) {
      const cpuPct = Math.round((resolutionFactors.cpuDemand - 1) * 100);
      const gpuPct = Math.round((resolutionFactors.gpuDemand - 1) * 100);

      const cpuText = cpuPct === 0 ? "CPU neutral" : `CPU ${cpuPct > 0 ? "+" : ""}${cpuPct}% demand`;
      const gpuText = gpuPct === 0 ? "GPU neutral" : `GPU ${gpuPct > 0 ? "+" : ""}${gpuPct}% demand`;

      methodResolution.textContent = `${cpuText} · ${gpuText}`;
    }

    if (methodWorkload) {
      methodWorkload.textContent =
        `${purposeFactors.label} · CPU ${Math.round(purposeFactors.cpuWeight * 100)}% / GPU ${Math.round(purposeFactors.gpuWeight * 100)}%`;
    }

    if (methodFps) {
      methodFps.textContent = fps
        ? `${fps} FPS target applied`
        : "No target FPS supplied";
    }

    if (methodRam) {
      methodRam.textContent = ram
        ? ram === "8"
          ? "8 GB penalty applied"
          : `${ram} GB selected`
        : "No RAM context supplied";
    }

    if (confidenceSummary) {
      confidenceSummary.textContent = confidence.label;
    }

    if (confidencePoints) {
      confidencePoints.innerHTML = "";

      const addPoint = (
        textValue: string,
        warning = false
      ) => {
        const item = document.createElement("div");
        item.className =
          `confidence-point${warning ? " warning" : ""}`;
        item.textContent = textValue;
        confidencePoints.appendChild(item);
      };

      const cpuEvidenceText =
        cpuBenchmarkStatus === "validated"
          ? "CPU gaming data is directly benchmark-calibrated"
          : cpuBenchmarkStatus === "derived"
            ? "CPU gaming data is derived from a validated sibling"
            : cpuPairingStatus.includes("provisional-calibrated")
              ? "CPU pairing data is calibrated but still provisional"
              : "CPU gaming data is provisional";

      const gpuEvidenceText =
        gpuBenchmarkStatus === "validated"
          ? "GPU raster data is directly benchmark-calibrated"
          : gpuBenchmarkStatus === "legacy-bridged"
            ? "GPU data comes from a measured legacy benchmark bridge"
            : "GPU gaming data is provisional";

      addPoint(cpuEvidenceText, cpuBenchmarkStatus === "provisional");
      addPoint(gpuEvidenceText, gpuBenchmarkStatus === "provisional");

      if (hasNativeGpuScaling) {
        addPoint("Native 1080p, 1440p, and 4K GPU scaling is available");
      } else {
        addPoint("Native three-resolution GPU scaling is incomplete", true);
      }

      if (fps) {
        addPoint(`Target FPS (${fps}) is included`);
      } else {
        addPoint(
          "Target FPS was not supplied; high-refresh behavior may differ",
          true
        );
      }

      if (ram) {
        addPoint(`RAM context (${ram} GB) is included`);
      } else {
        addPoint("RAM amount was not supplied", true);
      }

      addPoint(`Expected model range: ${confidence.low}–${confidence.high}%`);

      addPoint(
        "Individual games, settings, drivers, and background load can change the limiting component",
        true
      );
    }
    if (upgradeText) upgradeText.textContent = upgrade;

    if (experienceText) {
      const limitingHeadroom = Math.min(cpuEffective, gpuEffective);

      experienceText.textContent = getExperience(
        limitingHeadroom,
        resolution,
        purpose
      );
    }

    if (ramText) ramText.textContent = getRamMessage(ram);
    if (fpsText) fpsText.textContent = fpsDescription;

    if (meterRing) {
      const angle = clamp(bottleneck, 0, 100) * 3.6;
      meterRing.style.setProperty("--meter-angle", `${angle}deg`);
    }

    if (matchBadge) {
      matchBadge.setAttribute(
        "data-match",
        matchLabel.toLowerCase().replace(" ", "-")
      );
    }

    const cpuDisplay = clamp(Math.round(cpuScore), 0, 100);
    const gpuDisplay = clamp(Math.round(gpuScore), 0, 100);

    if (cpuBar) cpuBar.style.width = `${cpuDisplay}%`;
    if (gpuBar) gpuBar.style.width = `${gpuDisplay}%`;
    if (cpuBarValue) cpuBarValue.textContent = `${cpuDisplay}/100`;
    if (gpuBarValue) gpuBarValue.textContent = `${gpuDisplay}/100`;
    if (reportGrade) {
      reportGrade.textContent = `${buildGrade} · ${buildScore}`;
    }

    const gamingCombined = Math.round(
      cpuGaming * 0.38 + cpuSingle * 0.10 + gpuGaming * 0.52
    );

    const streamingCombined = Math.round(
      cpuMulti * 0.34 +
      cpuGaming * 0.18 +
      gpuRender * 0.18 +
      gpuGaming * 0.30
    );

    const editingCombined = Math.round(
      cpuProductivity * 0.32 +
      cpuMulti * 0.25 +
      gpuRender * 0.33 +
      gpuGaming * 0.10
    );

    if (gamingRating) gamingRating.textContent = qualitative(gamingCombined);
    if (streamingRating) {
      streamingRating.textContent = qualitative(streamingCombined);
    }
    if (editingRating) editingRating.textContent = qualitative(editingCombined);
    if (rayTracingRating) {
      rayTracingRating.textContent = qualitative(gpuRayTracing);
    }

    if (reportStrengths) {
      if (balanced && buildScore >= 84) {
        reportStrengths.textContent =
          `This is a well-matched ${purposeFactors.label.toLowerCase()} build. ` +
          `Its strongest advantage is balance: neither major component is dramatically out of place for ${resolutionFactors.label}.`;
      } else if (cpuIsLimit) {
        reportStrengths.textContent =
          `The GPU retains useful graphics headroom, so visual quality and resolution can often be increased before the graphics card becomes the primary constraint.`;
      } else {
        reportStrengths.textContent =
          `The CPU retains useful processing headroom, which is helpful for background tasks, game logic, streaming support, and future GPU upgrades.`;
      }
    }

    if (reportWatch) {
      if (balanced) {
        reportWatch.textContent =
          buildScore >= 84
            ? "No major pairing issue stands out. The specific game, application, graphics settings, and target frame rate will matter more than the small estimated mismatch."
            : "The components are balanced with each other, but absolute performance may still require reduced settings in demanding modern workloads.";
      } else if (cpuIsLimit) {
        reportWatch.textContent =
          "High-refresh gaming, simulation-heavy titles, large crowds, strategy games, and processor-heavy productivity work are the most likely places to expose the CPU limit.";
      } else {
        reportWatch.textContent =
          "Higher resolutions, ultra settings, ray tracing, heavy rendering, and VRAM-intensive workloads are the most likely places to expose the GPU limit.";
      }
    }

    if (upgradeSuggestions) {
      upgradeSuggestions.innerHTML = "";

      const mildMismatch = bottleneck <= 10;
      const highQualityBalanced = balanced && buildScore >= 84;

      let suggestions: string[] = [];
      let heading = "No urgent upgrade";

      if (highQualityBalanced) {
        heading = "No urgent upgrade";
      } else if (balanced) {
        heading = "Future performance upgrades";
        suggestions =
          gpuScore <= cpuScore
            ? topUpgradeNames(
                gpuSelect,
                purpose === "gaming" ? gpuPairingIndex : gpuGaming,
                purpose === "gaming" ? "pairingIndex" : "gaming",
                3,
                false
              )
            : topUpgradeNames(
                cpuSelect,
                purpose === "gaming" ? cpuPairingIndex : cpuGaming,
                purpose === "gaming" ? "pairingIndex" : "gaming",
                3,
                true
              );
      } else if (cpuIsLimit) {
        heading = mildMismatch
          ? "Optional CPU upgrades"
          : "CPU upgrade candidates";

        suggestions = topUpgradeNames(
          cpuSelect,
          purpose === "gaming" ? cpuPairingIndex : cpuGaming,
          purpose === "gaming" ? "pairingIndex" : "gaming",
          3,
          true
        );
      } else {
        heading = mildMismatch
          ? "Optional GPU upgrades"
          : "GPU upgrade candidates";

        suggestions = topUpgradeNames(
          gpuSelect,
          purpose === "gaming" ? gpuPairingIndex : gpuGaming,
          purpose === "gaming" ? "pairingIndex" : "gaming",
          3,
          false
        );
      }

      if (upgradeHeading) upgradeHeading.textContent = heading;

      if (highQualityBalanced) {
        const pill = document.createElement("span");
        pill.className = "upgrade-pill";
        pill.textContent = "Keep this pairing";
        upgradeSuggestions.appendChild(pill);
      } else if (suggestions.length) {
        suggestions.forEach((name) => {
          const pill = document.createElement("span");
          pill.className = "upgrade-pill";
          pill.textContent = name;
          upgradeSuggestions.appendChild(pill);
        });
      } else {
        const pill = document.createElement("span");
        pill.className = "upgrade-pill";
        pill.textContent = "No clear step-up in the current database";
        upgradeSuggestions.appendChild(pill);
      }
    }

    const analysis1080 = resolutionAnalysis(
      cpuScore,
      gpuScore,
      purpose,
      fps,
      "1080p",
      cpuPairingIndex,
      gpuPairingIndex,
      gpuFps1080,
      gpuFps1440,
      gpuFps4k
    );
    const analysis1440 = resolutionAnalysis(
      cpuScore,
      gpuScore,
      purpose,
      fps,
      "1440p",
      cpuPairingIndex,
      gpuPairingIndex,
      gpuFps1080,
      gpuFps1440,
      gpuFps4k
    );
    const analysis4k = resolutionAnalysis(
      cpuScore,
      gpuScore,
      purpose,
      fps,
      "4k",
      cpuPairingIndex,
      gpuPairingIndex,
      gpuFps1080,
      gpuFps1440,
      gpuFps4k
    );

    setResolutionCard("1080p", analysis1080, resolution);
    setResolutionCard("1440p", analysis1440, resolution);
    setResolutionCard("4k", analysis4k, resolution);

    if (actionList) {
      actionList.innerHTML = "";

      const actions: { title: string; text: string }[] = [];

      if (balanced) {
        actions.push({
          title: "Keep the current CPU–GPU pairing",
          text:
            "The selected components are closely matched for the chosen settings, so there is no urgent need to replace either part."
        });
      } else if (cpuIsLimit) {
        actions.push({
          title: "Prioritize the CPU only if the limitation matters to you",
          text:
            "A faster processor is most useful for high-refresh gaming, simulation-heavy titles, and processor-heavy applications."
        });
      } else {
        actions.push({
          title: "Prioritize the GPU for higher visual performance",
          text:
            "A faster graphics card is the clearest route to higher resolutions, heavier graphics settings, ray tracing, and rendering performance."
        });
      }

      if (analysis4k.gpuLimit && analysis4k.mismatch > 10) {
        actions.push({
          title: "Treat 4K as a GPU-heavy target",
          text:
            "The graphics card becomes more important at 3840 × 2160. Lowering graphics settings or upgrading the GPU can reduce that pressure."
        });
      }

      if (!ram) {
        actions.push({
          title: "Add your RAM amount for a more complete estimate",
          text:
            "Memory capacity can affect multitasking and demanding workloads, so selecting RAM improves the context of the result."
        });
      }

      if (!fps && purpose === "gaming") {
        actions.push({
          title: "Choose a target FPS if high refresh rate matters",
          text:
            "A 60 FPS target and a 240 FPS target can stress the CPU very differently. Adding a target helps the calculator model that demand."
        });
      }

      actions.slice(0, 4).forEach((action, index) => {
        const item = document.createElement("div");
        item.className = "action-item";

        const icon = document.createElement("span");
        icon.className = "action-icon";
        icon.textContent = String(index + 1);

        const copy = document.createElement("div");
        const heading = document.createElement("strong");
        heading.textContent = action.title;
        const paragraph = document.createElement("p");
        paragraph.textContent = action.text;

        copy.appendChild(heading);
        copy.appendChild(paragraph);
        item.appendChild(icon);
        item.appendChild(copy);
        actionList.appendChild(item);
      });
    }

    const ramGuide = ramGuidance(purpose);

    if (ramMinimum) ramMinimum.textContent = ramGuide.minimum;
    if (ramRecommended) ramRecommended.textContent = ramGuide.recommended;
    if (ramHeavy) ramHeavy.textContent = ramGuide.heavy;
    if (ramMinimumText) ramMinimumText.textContent = ramGuide.minimumText;
    if (ramRecommendedText) ramRecommendedText.textContent = ramGuide.recommendedText;
    if (ramHeavyText) ramHeavyText.textContent = ramGuide.heavyText;

    if (shoppingRamName) {
      shoppingRamName.textContent = `${ramGuide.recommended} DDR4 or DDR5 memory`;
    }

    const ramSearch = `${ramGuide.recommended} desktop RAM kit`;
    if (ramAmazonLink) ramAmazonLink.href = retailerUrl("amazon", ramSearch);
    if (ramNeweggLink) ramNeweggLink.href = retailerUrl("newegg", ramSearch);

    if (shoppingCpuName) shoppingCpuName.textContent = cpuName;
    if (shoppingGpuName) shoppingGpuName.textContent = gpuName;
    if (cpuAmazonLink) cpuAmazonLink.href = retailerUrl("amazon", cpuName);
    if (cpuNeweggLink) cpuNeweggLink.href = retailerUrl("newegg", cpuName);
    if (gpuAmazonLink) gpuAmazonLink.href = retailerUrl("amazon", gpuName);
    if (gpuNeweggLink) gpuNeweggLink.href = retailerUrl("newegg", gpuName);

    if (upgradeCardGrid) {
      upgradeCardGrid.innerHTML = "";

      let candidates: ReturnType<typeof getUpgradeCandidates> = [];
      let targetLabel = "";

      if (!balanced && cpuIsLimit) {
        candidates = getUpgradeCandidates(
          cpuSelect,
          purpose === "gaming" ? cpuPairingIndex : cpuGaming,
          purpose === "gaming" ? "pairingIndex" : "gaming",
          2,
          true
        );
        targetLabel = "CPU";
      } else if (!balanced && gpuIsLimit) {
        candidates = getUpgradeCandidates(
          gpuSelect,
          purpose === "gaming" ? gpuPairingIndex : gpuGaming,
          purpose === "gaming" ? "pairingIndex" : "gaming",
          2,
          false
        );
        targetLabel = "GPU";
      } else if (analysis4k.gpuLimit && analysis4k.mismatch > 8) {
        candidates = getUpgradeCandidates(
          gpuSelect,
          purpose === "gaming" ? gpuPairingIndex : gpuGaming,
          purpose === "gaming" ? "pairingIndex" : "gaming",
          2,
          false
        );
        targetLabel = "GPU for higher resolutions";
      }

      if (recommendedUpgradeTitle) {
        recommendedUpgradeTitle.textContent =
          candidates.length
            ? `${targetLabel} Upgrade Options`
            : "No Urgent Upgrade Required";
      }

      if (recommendedUpgradeIntro) {
        recommendedUpgradeIntro.textContent =
          candidates.length
            ? "These are nearby higher-performing options from the current database. The percentage is a relative internal score increase, not guaranteed FPS."
            : "This pairing does not currently show a strong enough mismatch to justify recommending a replacement purely for balance.";
      }

      if (!candidates.length) {
        const placeholder = document.createElement("div");
        placeholder.className = "upgrade-card-placeholder";
        placeholder.textContent =
          "Keep this pairing for now. Upgrade when your target resolution, frame rate, or workload demands more performance.";
        upgradeCardGrid.appendChild(placeholder);
      } else {
        candidates.forEach((candidate, index) => {
          const card = document.createElement("article");
          card.className = "upgrade-card";

          const kicker = document.createElement("span");
          kicker.className = "upgrade-card-kicker";
          kicker.textContent = index === 0 ? "BEST NEXT STEP" : "ALTERNATIVE";

          const heading = document.createElement("h5");
          heading.textContent = candidate.name;

          const improvement = document.createElement("div");
          improvement.className = "upgrade-improvement";
          improvement.textContent =
            purpose === "gaming"
              ? `≈ +${candidate.relativeGain}% benchmark-reference headroom`
              : `≈ +${candidate.relativeGain}% relative workload profile`;

          const note = document.createElement("p");
          note.textContent =
            "Check platform compatibility, physical dimensions, power requirements, and local pricing before purchasing.";

          const actions = document.createElement("div");
          actions.className = "upgrade-actions";

          const amazon = document.createElement("a");
          amazon.href = retailerUrl("amazon", candidate.name);
          amazon.target = "_blank";
          amazon.rel = "noopener noreferrer";
          amazon.textContent = "Search Amazon ↗";

          const newegg = document.createElement("a");
          newegg.href = retailerUrl("newegg", candidate.name);
          newegg.target = "_blank";
          newegg.rel = "noopener noreferrer";
          newegg.textContent = "Search Newegg ↗";

          actions.appendChild(amazon);
          actions.appendChild(newegg);

          card.appendChild(kicker);
          card.appendChild(heading);
          card.appendChild(improvement);
          card.appendChild(note);
          card.appendChild(actions);
          upgradeCardGrid.appendChild(card);
        });
      }
    }

    resultCard?.classList.add("show");

    if (resultCard) {
      requestAnimationFrame(() => {
        const y =
          resultCard.getBoundingClientRect().top +
          window.pageYOffset -
          24;

        window.scrollTo({
          top: y,
          behavior: "smooth"
        });
      });
    }
  });
</script>

