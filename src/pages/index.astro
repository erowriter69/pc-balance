  .ram-report,
  .shopping-report {
    margin-top: 22px;
    padding: 26px;
    border: 1px solid rgba(255, 255, 255, 0.065);
    border-radius: 18px;
    background: rgba(4, 14, 26, 0.34);
  }

  .decision-heading {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 22px;
    margin-bottom: 20px;
  }

  .decision-heading h4 {
    margin-top: 5px;
    color: #edf3fb;
    font-size: 1.15rem;
  }

  .recommendation-heading > p,
  .shopping-heading > p {
    max-width: 440px;
    color: #6f8299;
    text-align: right;
    font-size: 0.72rem;
    line-height: 1.55;
  }

  .resolution-result-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
  }

  .resolution-result-card {
    padding: 17px;
    border: 1px solid rgba(255, 255, 255, 0.055);
    border-radius: 13px;
    background: rgba(255, 255, 255, 0.018);
  }

  .resolution-result-card.selected-resolution {
    border-color: rgba(82, 140, 229, 0.36);
    background: rgba(37, 99, 235, 0.07);
  }

  .resolution-card-top {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    align-items: flex-start;
  }

  .resolution-card-top > div > span {
    display: block;
    color: #6fa6ff;
    font-size: 0.7rem;
    font-weight: 900;
  }

  .resolution-card-top > div > strong {
    display: block;
    margin-top: 3px;
    color: #cbd6e4;
    font-size: 0.78rem;
  }

  .resolution-status {
    padding: 5px 8px;
    border-radius: 8px;
    background: rgba(37, 99, 235, 0.09);
    color: #7faeff;
    font-size: 0.62rem;
    font-weight: 850;
  }

  .resolution-result-card p {
    min-height: 58px;
    margin-top: 14px;
    color: #8194ab;
    font-size: 0.75rem;
    line-height: 1.55;
  }

  .resolution-meta {
    margin-top: 13px;
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding-top: 11px;
    border-top: 1px solid rgba(255, 255, 255, 0.05);
    color: #60758e;
    font-size: 0.66rem;
    font-weight: 750;
  }

  .action-list {
    display: grid;
    gap: 9px;
  }

  .action-item {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 12px;
    align-items: flex-start;
    padding: 13px 15px;
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 11px;
    background: rgba(255, 255, 255, 0.015);
  }

  .action-icon {
    width: 27px;
    height: 27px;
    display: grid;
    place-items: center;
    border-radius: 8px;
    background: rgba(37, 99, 235, 0.11);
    color: #76a9ff;
    font-size: 0.68rem;
    font-weight: 900;
  }

  .action-item strong {
    display: block;
    color: #d3deeb;
    font-size: 0.8rem;
  }

  .action-item p {
    margin-top: 3px;
    color: #74889f;
    font-size: 0.72rem;
    line-height: 1.5;
  }

  .upgrade-card-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
  }

  .upgrade-card {
    padding: 18px;
    border: 1px solid rgba(79, 139, 230, 0.13);
    border-radius: 13px;
    background:
      radial-gradient(circle at 100% 0%, rgba(37, 99, 235, 0.07), transparent 40%),
      rgba(255, 255, 255, 0.016);
  }

  .upgrade-card-placeholder {
    grid-column: 1 / -1;
    padding: 24px;
    border: 1px dashed rgba(121, 147, 183, 0.15);
    border-radius: 13px;
    color: #71849c;
    text-align: center;
    font-size: 0.78rem;
  }

  .upgrade-card-kicker {
    color: #6499ec;
    font-size: 0.61rem;
    font-weight: 900;
    letter-spacing: 0.1em;
  }

  .upgrade-card h5 {
    margin-top: 6px;
    color: #e4ebf5;
    font-size: 0.95rem;
  }

  .upgrade-improvement {
    margin-top: 10px;
    color: #89b6fb;
    font-size: 0.8rem;
    font-weight: 850;
  }

  .upgrade-card p {
    margin-top: 8px;
    color: #75889f;
    font-size: 0.72rem;
    line-height: 1.5;
  }

  .upgrade-actions {
    margin-top: 14px;
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
  }

  .upgrade-actions a {
    padding: 7px 9px;
    border: 1px solid rgba(99, 155, 241, 0.17);
    border-radius: 8px;
    background: rgba(37, 99, 235, 0.06);
    color: #86b4fa;
    text-decoration: none;
    font-size: 0.66rem;
    font-weight: 750;
  }

  .upgrade-actions a:hover {
    border-color: rgba(99, 155, 241, 0.34);
    background: rgba(37, 99, 235, 0.11);
  }

  .ram-recommendation-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
  }

  .ram-recommendation-card {
    padding: 18px;
    border: 1px solid rgba(255, 255, 255, 0.055);
    border-radius: 13px;
    background: rgba(255, 255, 255, 0.016);
  }

  .ram-recommendation-card.featured {
    border-color: rgba(89, 145, 232, 0.3);
    background: rgba(37, 99, 235, 0.07);
  }

  .ram-recommendation-card > span {
    color: #617892;
    font-size: 0.61rem;
    font-weight: 900;
    letter-spacing: 0.1em;
  }

  .ram-recommendation-card > strong {
    display: block;
    margin-top: 8px;
    color: #edf3fb;
    font-size: 1.35rem;
  }

  .ram-recommendation-card p {
    margin-top: 7px;
    color: #788ca4;
    font-size: 0.72rem;
    line-height: 1.5;
  }

  .shopping-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
  }

  .shopping-card {
    padding: 17px;
    border: 1px solid rgba(255, 255, 255, 0.055);
    border-radius: 13px;
    background: rgba(255, 255, 255, 0.016);
  }

  .shopping-type {
    color: #6499ec;
    font-size: 0.62rem;
    font-weight: 900;
    letter-spacing: 0.1em;
  }

  .shopping-card > strong {
    display: block;
    min-height: 40px;
    margin-top: 7px;
    color: #dce5f1;
    font-size: 0.82rem;
    line-height: 1.4;
  }

  .retailer-links {
    margin-top: 13px;
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
  }

  .retailer-links a {
    padding: 7px 9px;
    border-radius: 8px;
    background: rgba(37, 99, 235, 0.08);
    color: #83b1f8;
    text-decoration: none;
    font-size: 0.65rem;
    font-weight: 750;
  }

  .retailer-links a:hover {
    background: rgba(37, 99, 235, 0.14);
  }

  .build-report {
    margin-top: 22px;
    padding: 28px;
    border: 1px solid rgba(87, 145, 235, 0.16);
    border-radius: 18px;
    background:
      radial-gradient(circle at 100% 0%, rgba(37, 99, 235, 0.08), transparent 38%),
      rgba(4, 14, 26, 0.42);
  }

  .report-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 23px;
  }

  .report-heading h4 {
    margin-top: 5px;
    color: #edf3fb;
    font-size: 1.25rem;
  }

  .report-grade {
    padding: 8px 12px;
    border: 1px solid rgba(99, 155, 241, 0.24);
    border-radius: 10px;
    background: rgba(37, 99, 235, 0.09);
    color: #7babf8;
    font-weight: 900;
  }

  .performance-bars {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 18px;
  }

  .bar-top {
    margin-bottom: 8px;
    display: flex;
    justify-content: space-between;
    color: #8395ad;
    font-size: 0.75rem;
  }

  .bar-top strong {
    color: #cbd8e8;
  }

  .bar-track {
    height: 9px;
    overflow: hidden;
    border-radius: 99px;
    background: rgba(255, 255, 255, 0.065);
  }

  .bar-track span {
    display: block;
    width: 0;
    height: 100%;
    border-radius: inherit;
    background: linear-gradient(90deg, #315fba, #68a2ff);
    transition: width 0.45s ease;
  }

  .report-rating-grid {
    margin-top: 22px;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 10px;
  }

  .report-rating {
    padding: 13px;
    border: 1px solid rgba(255, 255, 255, 0.055);
    border-radius: 11px;
    background: rgba(255, 255, 255, 0.018);
  }

  .report-rating span {
    color: #657991;
    font-size: 0.66rem;
  }

  .report-rating strong {
    display: block;
    margin-top: 4px;
    color: #d4deeb;
    font-size: 0.82rem;
  }

  .report-summary-grid {
    margin-top: 16px;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
  }

  .report-summary-card {
    padding: 17px;
    border: 1px solid rgba(255, 255, 255, 0.055);
    border-radius: 12px;
  }

  .report-summary-card span,
  .upgrade-suggestions > div:first-child span {
    color: #679cf0;
    font-size: 0.62rem;
    font-weight: 900;
    letter-spacing: 0.1em;
  }

  .report-summary-card p {
    margin-top: 7px;
    color: #8fa0b6;
    line-height: 1.6;
    font-size: 0.8rem;
  }

  .upgrade-suggestions {
    margin-top: 16px;
    padding: 17px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    border: 1px solid rgba(75, 133, 221, 0.14);
    border-radius: 12px;
    background: rgba(37, 99, 235, 0.045);
  }

  .upgrade-suggestions h5 {
    margin-top: 4px;
    color: #dce6f3;
    font-size: 0.9rem;
  }

  .upgrade-pills {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 7px;
  }

  .upgrade-pill {
    padding: 7px 9px;
    border-radius: 8px;
    background: rgba(37, 99, 235, 0.12);
    color: #89b5fa;
    font-size: 0.68rem;
    font-weight: 750;
  }

  .hardware-profile-grid {
    margin-top: 28px;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 18px;
  }

  .hardware-profile {
    padding: 22px;
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: 17px;
    background:
      radial-gradient(circle at 100% 0%, rgba(45, 103, 201, 0.08), transparent 38%),
      rgba(7, 18, 33, 0.58);
  }

  .profile-heading {
    display: flex;
    align-items: center;
    gap: 13px;
    padding-bottom: 18px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }

  .profile-icon {
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    border: 1px solid rgba(92, 148, 235, 0.28);
    border-radius: 12px;
    background: rgba(37, 99, 235, 0.11);
    color: #78aaff;
    font-size: 0.68rem;
    font-weight: 900;
  }

  .profile-heading small {
    display: block;
    color: #61748d;
    font-size: 0.62rem;
    font-weight: 900;
    letter-spacing: 0.11em;
  }

  .profile-heading h3 {
    margin-top: 3px;
    color: #eaf0f8;
    font-size: 1rem;
  }

  .profile-specs {
    margin-top: 17px;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px;
  }

  .profile-specs > div {
    min-height: 68px;
    padding: 12px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 11px;
    background: rgba(255, 255, 255, 0.018);
  }

  .profile-specs span {
    color: #60738b;
    font-size: 0.64rem;
    font-weight: 700;
  }

  .profile-specs strong {
    margin-top: 4px;
    color: #cbd5e2;
    font-size: 0.82rem;
  }

  .calculate-area {
    margin-top: 34px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .calculate-button {
    min-width: 275px;
    min-height: 56px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 18px;
    border: 0;
    border-radius: 12px;
    background: linear-gradient(135deg, #2d67c9, #356fda);
    color: #fff;
    font-weight: 800;
    cursor: pointer;
    box-shadow: 0 12px 32px rgba(37, 99, 235, 0.25);
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease;
  }

  .calculate-button:hover {
    transform: translateY(-2px);
    box-shadow: 0 16px 35px rgba(37, 99, 235, 0.32);
  }

  .button-arrow {
    font-size: 1.15rem;
  }

  .calculate-area p {
    max-width: 630px;
    margin-top: 15px;
    color: #687b93;
    text-align: center;
    font-size: 0.77rem;
    line-height: 1.6;
  }

  .result-card {
    display: none;
    margin-top: 28px;
    padding: 34px;
    border: 1px solid rgba(110, 163, 247, 0.18);
    border-radius: 24px;
    background:
      radial-gradient(circle at 92% 8%, rgba(58, 111, 207, 0.12), transparent 32%),
      rgba(11, 24, 43, 0.96);
    box-shadow:
      0 28px 80px rgba(0, 0, 0, 0.28),
      inset 0 1px rgba(255, 255, 255, 0.04);
  }

  .result-card.show {
    display: block;
    animation: resultReveal 0.45s ease both;
  }

  @keyframes resultReveal {
    from {
      opacity: 0;
      transform: translateY(12px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .result-topline {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 32px;
    padding-bottom: 28px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.07);
  }

  .result-label,
  .meter-kicker,
  .recommendation-box span {
    color: #6fa6ff;
    font-size: 0.7rem;
    font-weight: 900;
    letter-spacing: 0.15em;
  }

  .result-card h3 {
    margin-top: 8px;
    color: #f6f8fc;
    font-size: clamp(1.65rem, 3vw, 2.25rem);
    letter-spacing: -0.035em;
  }

  .result-pair {
    margin-top: 8px;
    color: #8395ad;
    font-size: 0.9rem;
  }

  .match-badge {
    min-width: 118px;
    padding: 16px 18px;
    display: flex;
    flex-direction: column;
    align-items: center;
    border: 1px solid rgba(95, 151, 239, 0.24);
    border-radius: 16px;
    background: rgba(37, 99, 235, 0.08);
  }

  .match-badge strong {
    color: #79aaff;
    font-size: 1.75rem;
    line-height: 1;
  }

  .match-badge span {
    margin-top: 6px;
    color: #8295ad;
    font-size: 0.66rem;
    font-weight: 700;
  }

  .result-main {
    display: grid;
    grid-template-columns: 1.4fr 0.6fr;
    gap: 28px;
    padding: 30px 0;
  }

  .bottleneck-meter {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 28px;
    align-items: center;
  }

  .meter-ring {
    --meter-angle: 0deg;
    width: 138px;
    height: 138px;
    flex: 0 0 auto;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background:
      radial-gradient(circle at center, #0b182b 57%, transparent 58%),
      conic-gradient(#5f96ee var(--meter-angle), rgba(107, 130, 162, 0.15) 0);
    box-shadow: 0 0 36px rgba(48, 103, 190, 0.12);
  }

  .meter-inner {
    width: 106px;
    height: 106px;
    display: grid;
    place-items: center;
    align-content: center;
    border: 1px solid rgba(255, 255, 255, 0.055);
    border-radius: 50%;
    background: #091426;
  }

  .meter-inner strong {
    color: #f7f9fc;
    font-size: 2.15rem;
    line-height: 1;
  }

  .meter-inner span {
    margin-top: 5px;
    color: #71849d;
    font-size: 0.66rem;
    font-weight: 700;
  }

  .meter-copy h4 {
    margin-top: 8px;
    color: #eef3fa;
    font-size: 1.25rem;
  }

  .meter-copy p {
    max-width: 590px;
    margin-top: 10px;
    color: #8fa0b6;
    line-height: 1.7;
    font-size: 0.9rem;
  }

  .meter-copy .estimate-range {
    margin-top: 12px;
    color: #78a9ff;
    font-size: 0.82rem;
    font-weight: 750;
    letter-spacing: 0.01em;
  }

  .result-stats {
    display: grid;
    gap: 10px;
  }

  .result-stat {
    min-height: 74px;
    padding: 14px 16px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    border: 1px solid rgba(255, 255, 255, 0.065);
    border-radius: 13px;
    background: rgba(255, 255, 255, 0.025);
  }

  .result-stat span {
    color: #6f8198;
    font-size: 0.7rem;
    font-weight: 700;
  }

  .result-stat strong {
    margin-top: 4px;
    color: #dce5f1;
    font-size: 0.92rem;
  }

  .recommendation-box {
    padding: 16px 18px;
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 16px;
    align-items: flex-start;
    border: 1px solid rgba(76, 132, 218, 0.16);
    border-radius: 15px;
    background: rgba(37, 99, 235, 0.055);
  }

  .recommendation-icon {
    width: 34px;
    height: 34px;
    display: grid;
    place-items: center;
    border-radius: 10px;
    background: rgba(37, 99, 235, 0.14);
    color: #76a9ff;
    font-size: 1rem;
    font-weight: 900;
  }

  .recommendation-box p {
    margin-top: 5px;
    color: #a1afc1;
    line-height: 1.55;
    font-size: 0.82rem;
  }

  .experience-grid {
    margin-top: 18px;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
  }

  .experience-item {
    padding: 15px 16px;
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 11px;
    align-items: center;
    border: 1px solid rgba(255, 255, 255, 0.055);
    border-radius: 13px;
    background: rgba(255, 255, 255, 0.02);
  }

  .experience-dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: #5f96ee;
    box-shadow: 0 0 13px rgba(95, 150, 238, 0.5);
  }

  .experience-item small {
    display: block;
    color: #61748d;
    font-size: 0.61rem;
    font-weight: 800;
    letter-spacing: 0.08em;
  }

  .experience-item strong {
    display: block;
    margin-top: 3px;
    color: #cbd5e2;
    font-size: 0.82rem;
  }

  .method-card {
    margin-top: 18px;
    padding: 24px;
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 16px;
    background: rgba(4, 13, 25, 0.38);
  }

  .method-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
  }

  .method-heading h4 {
    margin-top: 5px;
    color: #edf3fb;
    font-size: 1.08rem;
  }

  .method-status {
    padding: 7px 10px;
    border: 1px solid rgba(99, 155, 241, 0.2);
    border-radius: 9px;
    background: rgba(37, 99, 235, 0.07);
    color: #7eaff9;
    font-size: 0.66rem;
    font-weight: 800;
  }

  .method-grid {
    margin-top: 18px;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px;
  }

  .method-item {
    padding: 13px;
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.018);
  }

  .method-item span {
    display: block;
    color: #657991;
    font-size: 0.65rem;
  }

  .method-item strong {
    display: block;
    margin-top: 4px;
    color: #d5deea;
    font-size: 0.8rem;
  }

  .confidence-explainer {
    margin-top: 16px;
    padding: 16px;
    border: 1px solid rgba(69, 126, 214, 0.12);
    border-radius: 12px;
    background: rgba(37, 99, 235, 0.035);
  }

  .confidence-title {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    align-items: center;
  }

  .confidence-title span {
    color: #679cf0;
    font-size: 0.62rem;
    font-weight: 900;
    letter-spacing: 0.1em;
  }

  .confidence-title strong {
    color: #dce6f3;
    font-size: 0.78rem;
  }

  .confidence-points {
    margin-top: 12px;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 8px 12px;
  }

  .confidence-point {
    display: flex;
    gap: 8px;
    align-items: flex-start;
    color: #8193aa;
    font-size: 0.72rem;
    line-height: 1.45;
  }

  .confidence-point::before {
    content: "✓";
    color: #6fa6ff;
    font-weight: 900;
