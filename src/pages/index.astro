                  <select id="ram" class="native-control" aria-hidden="true" tabindex="-1">
                    <option value="">Not selected</option>
                    <option value="8">8 GB</option>
                    <option value="16">16 GB</option>
                    <option value="32">32 GB</option>
                    <option value="64">64 GB</option>
                    <option value="128">128 GB+</option>
                  </select>

                  <div class="chip-choices" data-control="ram">
                    <button type="button" class="select-chip active" data-value="">Auto</button>
                    <button type="button" class="select-chip" data-value="8">8 GB</button>
                    <button type="button" class="select-chip" data-value="16">16 GB</button>
                    <button type="button" class="select-chip" data-value="32">32 GB</button>
                    <button type="button" class="select-chip" data-value="64">64 GB</button>
                    <button type="button" class="select-chip" data-value="128">128+</button>
                  </div>
                </div>

                <div class="compact-choice-panel">
                  <div class="compact-title">
                    <span>Target FPS</span>
                    <small>Optional</small>
                  </div>

                  <select id="fps" class="native-control" aria-hidden="true" tabindex="-1">
                    <option value="">Not selected</option>
                    <option value="60">60 FPS</option>
                    <option value="75">75 FPS</option>
                    <option value="120">120 FPS</option>
                    <option value="144">144 FPS</option>
                    <option value="165">165 FPS</option>
                    <option value="240">240 FPS</option>
                  </select>

                  <div class="chip-choices" data-control="fps">
                    <button type="button" class="select-chip active" data-value="">Auto</button>
                    <button type="button" class="select-chip" data-value="60">60</button>
                    <button type="button" class="select-chip" data-value="75">75</button>
                    <button type="button" class="select-chip" data-value="120">120</button>
                    <button type="button" class="select-chip" data-value="144">144</button>
                    <button type="button" class="select-chip" data-value="165">165</button>
                    <button type="button" class="select-chip" data-value="240">240</button>
                  </div>
                </div>
              </div>
            </div>

            <div class="hardware-profile-grid">
              <article class="hardware-profile" id="cpuProfile">
                <div class="profile-heading">
                  <span class="profile-icon">CPU</span>
                  <div>
                    <small>PROCESSOR PROFILE</small>
                    <h3 id="cpuProfileName">Select a CPU</h3>
                  </div>
                </div>

                <div class="profile-specs">
                  <div>
                    <span>Architecture</span>
                    <strong id="cpuArchitecture">—</strong>
                  </div>
                  <div>
                    <span>Cores / Threads</span>
                    <strong id="cpuCoresThreads">—</strong>
                  </div>
                  <div>
                    <span>Released</span>
                    <strong id="cpuYear">—</strong>
                  </div>
                  <div>
                    <span>Gaming Profile</span>
                    <strong id="cpuGamingProfile">—</strong>
                  </div>
                  <div>
                    <span>Productivity Profile</span>
                    <strong id="cpuProductivityProfile">—</strong>
                  </div>
                  <div>
                    <span>Single-Core Profile</span>
                    <strong id="cpuSingleProfile">—</strong>
                  </div>
                </div>
              </article>

              <article class="hardware-profile" id="gpuProfile">
                <div class="profile-heading">
                  <span class="profile-icon">GPU</span>
                  <div>
                    <small>GRAPHICS CARD PROFILE</small>
                    <h3 id="gpuProfileName">Select a GPU</h3>
                  </div>
                </div>

                <div class="profile-specs">
                  <div>
                    <span>Architecture</span>
                    <strong id="gpuArchitecture">—</strong>
                  </div>
                  <div>
                    <span>VRAM</span>
                    <strong id="gpuVram">—</strong>
                  </div>
                  <div>
                    <span>Released</span>
                    <strong id="gpuYear">—</strong>
                  </div>
                  <div>
